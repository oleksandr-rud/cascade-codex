{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "cases": {
      "type": "array", "minItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "request", "authority", "expected_route", "required_controls", "forbidden_controls", "expected_blocked", "criterion"],
        "properties": {
          "id": { "type": "string", "pattern": "^TA-C[0-9]{3}$" },
          "request": { "type": "string", "minLength": 1 },
          "authority": { "type": "array", "items": { "type": "string" } },
          "expected_route": { "type": "string" },
          "required_controls": { "type": "array", "items": { "type": "string" } },
          "forbidden_controls": { "type": "array", "items": { "type": "string" } },
          "expected_blocked": { "type": "boolean" },
          "criterion": { "type": "string", "pattern": "^TR-[0-9]{2}$" }
        }
      }
    }
  }
}
