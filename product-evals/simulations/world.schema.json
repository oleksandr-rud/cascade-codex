{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/simulation-world.schema.json",
  "title": "Cascade simulation world",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "fixture_file",
    "allowed_actions",
    "negative_behaviors",
    "cleanup"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "fixture_file": {
      "type": "string",
      "pattern": "^product-evals/simulations/(harness|product)/.+/worlds/.+\\.json$"
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "assert",
          "set",
          "increment",
          "deny",
          "fail"
        ]
      }
    },
    "negative_behaviors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reset_to_fixture"
      ],
      "properties": {
        "reset_to_fixture": {
          "const": true
        }
      }
    }
  }
}
