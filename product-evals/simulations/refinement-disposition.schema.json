{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/refinement-disposition.schema.json",
  "title": "Cascade persona refinement disposition receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "disposition_id", "proposal", "persona", "derivation",
    "decision", "reviewer_identity", "reviewed_at", "external_evidence",
    "persona_revision_authorized", "direct_persona_mutation_allowed", "next_route",
    "status", "blockers"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "disposition_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "path", "sha256"],
      "properties": {
        "proposal_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "path": { "type": "string", "pattern": "^\\.artifacts/product-evals/.+/refinements/.+\\.json$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "persona": { "$ref": "#/$defs/personaReference" },
    "derivation": { "$ref": "#/$defs/derivationReference" },
    "decision": { "enum": ["ACCEPTED", "REJECTED", "NEEDS_EVIDENCE", "SIMULATOR_REPAIR"] },
    "reviewer_identity": { "type": "string", "minLength": 1 },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "external_evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "manifest_path", "manifest_sha256", "evidence_sha256"],
        "properties": {
          "evidence_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
          "manifest_path": { "type": "string", "minLength": 1 },
          "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "persona_revision_authorized": { "type": "boolean" },
    "direct_persona_mutation_allowed": { "const": false },
    "next_route": { "enum": ["synthesis-to-spec", "collect-external-evidence", "repair-simulator", "none"] },
    "status": { "const": "REVIEWED" },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "personaReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persona_id", "revision", "path", "sha256"],
      "properties": {
        "persona_id": { "type": "string", "pattern": "^P-[0-9]{3}$" },
        "revision": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "pattern": "^docs/product/personas/.+\\.md$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "derivationReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "path": { "type": "string", "pattern": "^product-evals/simulations/(harness|product)/.+/derivations/.+\\.json$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
