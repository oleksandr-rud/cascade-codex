{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/persona-derivation.schema.json",
  "title": "Cascade product-persona derivation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "simulation_id",
    "population_id",
    "mode",
    "weight_semantics",
    "product_personas",
    "dimensions",
    "invariants",
    "mutation_axes",
    "actors",
    "generator",
    "evidence_sources",
    "review"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "simulation_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "population_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "mode": {
      "enum": ["representative", "coverage", "stress", "counterfactual"]
    },
    "weight_semantics": {
      "enum": ["estimated-prevalence", "test-allocation"]
    },
    "prevalence_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "reference_window",
        "sample_description",
        "sha256",
        "reviewed_by"
      ],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "reference_window": { "type": "string", "minLength": 1 },
        "sample_description": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reviewed_by": { "type": "string", "minLength": 1 }
      }
    },
    "product_personas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/personaReference" }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "source_persona_ids",
          "confidence",
          "uncertainty",
          "permitted_variation"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
          "description": { "type": "string", "minLength": 1 },
          "source_persona_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^P-[0-9]{3}$" }
          },
          "confidence": { "enum": ["low", "medium", "high"] },
          "uncertainty": { "type": "string", "minLength": 1 },
          "permitted_variation": { "type": "boolean" }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "mutation_axes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "values", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
          "values": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/actor" }
    },
    "generator": { "$ref": "#/$defs/generator" },
    "evidence_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "reference",
          "minimized",
          "source_authority",
          "reference_window",
          "usage_rights",
          "sensitivity",
          "retention_policy",
          "permitted_purpose",
          "prohibited_uses",
          "operator_attestation"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
          "kind": {
            "enum": [
              "research",
              "feedback",
              "behavioral-data",
              "expert-review",
              "product-spec",
              "framework-fixture"
            ]
          },
          "reference": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "minimized": { "const": true },
          "source_authority": { "type": "string", "minLength": 1 },
          "reference_window": { "type": "string", "minLength": 1 },
          "usage_rights": {
            "enum": ["fixture", "internal-research", "public", "licensed", "consented"]
          },
          "sensitivity": { "enum": ["none", "low", "restricted"] },
          "retention_policy": { "$ref": "#/$defs/retentionPolicy" },
          "permitted_purpose": { "type": "string", "minLength": 1 },
          "prohibited_uses": { "$ref": "#/$defs/nonEmptyStrings" },
          "operator_attestation": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/$defs/operatorAttestation" }
            ]
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "framework-fixture" } }, "required": ["kind"] },
            "then": { "properties": { "usage_rights": { "const": "fixture" } } },
            "else": {
              "required": ["sha256"],
              "not": { "properties": { "usage_rights": { "const": "fixture" } }, "required": ["usage_rights"] }
            }
          },
          {
            "if": { "properties": { "sensitivity": { "const": "restricted" } }, "required": ["sensitivity"] },
            "then": { "properties": { "operator_attestation": { "$ref": "#/$defs/operatorAttestation" } } }
          }
        ]
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer_identity", "reviewed_at"],
      "properties": {
        "status": { "enum": ["draft", "reviewed", "approved", "superseded"] },
        "reviewer_identity": { "type": ["string", "null"] },
        "reviewed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "weight_semantics": { "const": "estimated-prevalence" } },
        "required": ["weight_semantics"]
      },
      "then": {
        "properties": { "mode": { "const": "representative" } },
        "required": ["prevalence_evidence"]
      },
      "else": {
        "not": { "required": ["prevalence_evidence"] }
      }
    }
  ],
  "$defs": {
    "personaReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persona_id", "revision", "path", "sha256"],
      "properties": {
        "persona_id": { "type": "string", "pattern": "^P-[0-9]{3}$" },
        "revision": { "type": "integer", "minimum": 1 },
        "path": {
          "type": "string",
          "pattern": "^docs/product/personas/.+\\.md$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version", "input_digest"],
      "properties": {
        "kind": { "enum": ["deterministic-manifest", "model-backed"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "input_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "model": { "type": "string", "minLength": 1 },
        "prompt_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "tool_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "model-backed" } } },
          "then": { "required": ["model", "prompt_digest", "tool_digest"] }
        }
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "weight",
        "actor_class",
        "persona_ids",
        "goals",
        "invariants",
        "knowledge",
        "uncertainty",
        "decision_policy",
        "communication_policy",
        "state_memory",
        "friction_behaviors",
        "abstention",
        "slices"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "actor_class": {
          "enum": ["representative", "variant", "edge", "counterfactual"]
        },
        "persona_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^P-[0-9]{3}$" }
        },
        "goals": { "$ref": "#/$defs/nonEmptyStrings" },
        "invariants": { "$ref": "#/$defs/nonEmptyStrings" },
        "knowledge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["known", "unknown"],
          "properties": {
            "known": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "unknown": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "uncertainty": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "decision_policy": { "$ref": "#/$defs/decisionPolicy" },
        "communication_policy": { "$ref": "#/$defs/communicationPolicy" },
        "state_memory": { "$ref": "#/$defs/stateMemory" },
        "friction_behaviors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "abstention": { "$ref": "#/$defs/abstention" },
        "slices": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "decisionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "retry_limit", "stop_on_blocked"],
      "properties": {
        "strategy": { "enum": ["goal-directed", "rule-based", "scripted", "exploratory"] },
        "retry_limit": { "type": "integer", "minimum": 0, "maximum": 10 },
        "stop_on_blocked": { "type": "boolean" }
      }
    },
    "communicationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "clarification"],
      "properties": {
        "style": { "enum": ["direct", "concise", "detailed", "ambiguous", "adversarial"] },
        "clarification": { "enum": ["ask", "infer-within-evidence", "abstain"] }
      }
    },
    "stateMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "max_facts"],
      "properties": {
        "scope": { "enum": ["turn", "scenario", "session"] },
        "max_facts": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "abstention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when_unsupported", "when_conflicted"],
      "properties": {
        "when_unsupported": { "const": true },
        "when_conflicted": { "type": "boolean" }
      }
    },
    "retentionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "deletion_owner", "expires_at"],
      "properties": {
        "mode": { "enum": ["source-controlled", "manual-review", "retain-until"] },
        "deletion_owner": { "type": "string", "minLength": 1 },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "retain-until" } }, "required": ["mode"] },
          "then": { "properties": { "expires_at": { "type": "string", "format": "date-time" } } }
        }
      ]
    },
    "operatorAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "attested_at", "encryption_at_rest_confirmed", "access_scope_confirmed"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "attested_at": { "type": "string", "format": "date-time" },
        "encryption_at_rest_confirmed": { "const": true },
        "access_scope_confirmed": { "const": true }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
