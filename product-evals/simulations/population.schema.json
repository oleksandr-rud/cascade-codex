{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/simulation-population.schema.json",
  "title": "Cascade simulation population",
  "oneOf": [
    { "$ref": "#/$defs/legacyPopulation" },
    { "$ref": "#/$defs/personaDerivedPopulation" }
  ],
  "$defs": {
    "legacyPopulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "source", "actors"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "description"],
          "properties": {
            "kind": { "enum": ["synthetic", "expert-authored", "production-derived"] },
            "description": { "type": "string", "minLength": 1 },
            "reference_window": { "type": "string" },
            "minimized": { "type": "boolean" }
          }
        },
        "actors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/legacyActor" }
        }
      }
    },
    "personaDerivedPopulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "mode", "weight_semantics", "source", "actors"],
      "properties": {
        "schema_version": { "const": 2 },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "mode": { "enum": ["representative", "coverage", "stress", "counterfactual"] },
        "weight_semantics": { "enum": ["estimated-prevalence", "test-allocation"] },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "description", "derivation", "product_personas", "generator", "minimized"],
          "properties": {
            "kind": { "const": "persona-derived" },
            "description": { "type": "string", "minLength": 1 },
            "derivation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "path", "sha256"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
                "path": { "type": "string", "pattern": "^product-evals/simulations/(harness|product)/.+/derivations/.+\\.json$" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            },
            "product_personas": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["persona_id", "revision", "path", "sha256"],
                "properties": {
                  "persona_id": { "type": "string", "pattern": "^P-[0-9]{3}$" },
                  "revision": { "type": "integer", "minimum": 1 },
                  "path": { "type": "string", "pattern": "^docs/product/personas/.+\\.md$" },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
              }
            },
            "generator": { "$ref": "#/$defs/generator" },
            "minimized": { "const": true }
          }
        },
        "actors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/derivedActor" }
        }
      }
    },
    "legacyActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weight", "behavior", "slices"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "behavior": { "type": "object" },
        "slices": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "derivedActor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "weight",
        "actor_class",
        "persona_ids",
        "goals",
        "invariants",
        "knowledge",
        "uncertainty",
        "decision_policy",
        "communication_policy",
        "state_memory",
        "friction_behaviors",
        "abstention",
        "slices"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "actor_class": { "enum": ["representative", "variant", "edge", "counterfactual"] },
        "persona_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^P-[0-9]{3}$" }
        },
        "goals": { "$ref": "#/$defs/nonEmptyStrings" },
        "invariants": { "$ref": "#/$defs/nonEmptyStrings" },
        "knowledge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["known", "unknown"],
          "properties": {
            "known": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "unknown": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "uncertainty": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "decision_policy": { "$ref": "#/$defs/decisionPolicy" },
        "communication_policy": { "$ref": "#/$defs/communicationPolicy" },
        "state_memory": { "$ref": "#/$defs/stateMemory" },
        "friction_behaviors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "abstention": { "$ref": "#/$defs/abstention" },
        "slices": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "decisionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "retry_limit", "stop_on_blocked"],
      "properties": {
        "strategy": { "enum": ["goal-directed", "rule-based", "scripted", "exploratory"] },
        "retry_limit": { "type": "integer", "minimum": 0, "maximum": 10 },
        "stop_on_blocked": { "type": "boolean" }
      }
    },
    "communicationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "clarification"],
      "properties": {
        "style": { "enum": ["direct", "concise", "detailed", "ambiguous", "adversarial"] },
        "clarification": { "enum": ["ask", "infer-within-evidence", "abstain"] }
      }
    },
    "stateMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "max_facts"],
      "properties": {
        "scope": { "enum": ["turn", "scenario", "session"] },
        "max_facts": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "abstention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when_unsupported", "when_conflicted"],
      "properties": {
        "when_unsupported": { "const": true },
        "when_conflicted": { "type": "boolean" }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version", "input_digest"],
      "properties": {
        "kind": { "enum": ["deterministic-manifest", "model-backed"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "input_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "model": { "type": "string", "minLength": 1 },
        "prompt_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "tool_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
