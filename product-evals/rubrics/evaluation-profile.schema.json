{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/simulation-evaluation-profile.schema.json",
  "title": "Cascade simulation evaluation profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "provider",
    "timeout_ms"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "provider": {
      "enum": [
        "fixture",
        "codex"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "reasoning_effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 600000
    },
    "rubric_file": {
      "type": "string",
      "pattern": "^product-evals/rubrics/.+\\.json$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "const": "codex"
          }
        }
      },
      "then": {
        "required": [
          "model",
          "reasoning_effort",
          "rubric_file"
        ]
      }
    }
  ]
}
