{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/simulation-evaluation-receipt.schema.json",
  "title": "Cascade simulation evaluation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "run_id",
    "campaign_id",
    "operator_identity",
    "evaluator_identity",
    "provider",
    "profile_id",
    "profile_digest",
    "rubric_id",
    "rubric_digest",
    "model",
    "reasoning_effort",
    "source_manifest_digest",
    "execution_receipt_digest",
    "calibration_receipt_digest",
    "evaluation_input_digest",
    "input_manifest_digest",
    "provider_trace_digest",
    "provider_output_digest",
    "refinement_proposal_bindings",
    "usage",
    "claim_ledger",
    "status",
    "root_cause",
    "earliest_failure",
    "residual_uncertainty",
    "next_route",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "operator_identity": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_identity": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "enum": [
        "fixture",
        "codex"
      ]
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_digest": {
      "$ref": "#/$defs/digest"
    },
    "rubric_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "rubric_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasoning_effort": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        null
      ]
    },
    "source_manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "execution_receipt_digest": {
      "$ref": "#/$defs/digest"
    },
    "calibration_receipt_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluation_input_digest": {
      "$ref": "#/$defs/digest"
    },
    "input_manifest_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_trace_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_output_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "refinement_proposal_bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposal_id", "candidate_digest"],
        "properties": {
          "proposal_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]+$"
          },
          "candidate_digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "usage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "claim_ledger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "root_cause": {
      "type": "string",
      "minLength": 1
    },
    "earliest_failure": {
      "type": [
        "string",
        "null"
      ]
    },
    "residual_uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_route": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "class",
        "status",
        "reason",
        "evidence"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "PARTIALLY_SUPPORTED",
            "UNSUPPORTED",
            "CONFLICTING",
            "BLOCKED",
            "NOT_RUN",
            "INVALID"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "const": "codex"
          }
        }
      },
      "then": {
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "reasoning_effort": {
            "type": "string"
          },
          "rubric_id": {
            "type": "string",
            "minLength": 1
          },
          "rubric_digest": {
            "$ref": "#/$defs/digest"
          },
          "input_manifest_digest": {
            "$ref": "#/$defs/digest"
          },
          "provider_trace_digest": {
            "$ref": "#/$defs/digest"
          },
          "provider_output_digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  ]
}
