{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cascade Codex simulation evaluation output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "run_id",
    "campaign_id",
    "source_manifest_digest",
    "execution_receipt_digest",
    "evaluation_input_digest",
    "input_manifest_digest",
    "evaluator_identity",
    "status",
    "mechanical_gate_status",
    "claim_assessments",
    "refinement_proposals",
    "root_cause",
    "earliest_failure",
    "residual_uncertainty",
    "next_route"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "source_manifest_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "execution_receipt_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluation_input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_manifest_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluator_identity": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "mechanical_gate_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "claim_assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "status",
          "reason",
          "evidence"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "SUPPORTED",
              "PARTIALLY_SUPPORTED",
              "UNSUPPORTED",
              "CONFLICTING",
              "BLOCKED",
              "NOT_RUN",
              "INVALID"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "refinement_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposal_id",
          "persona_id",
          "derivation_id",
          "proposal_type",
          "target_field",
          "summary",
          "rationale",
          "recommended_change",
          "evidence_paths",
          "confidence",
          "disposition_route"
        ],
        "properties": {
          "proposal_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
          "persona_id": { "type": "string", "pattern": "^P-[0-9]{3}$" },
          "derivation_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
          "proposal_type": {
            "enum": [
              "missing-dimension",
              "stale-assumption",
              "contradiction",
              "journey-gap",
              "scenario-gap",
              "requirement-gap",
              "accessibility-gap",
              "permission-gap",
              "simulator-defect",
              "research-question"
            ]
          },
          "target_field": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "recommended_change": { "type": "string", "minLength": 1 },
          "evidence_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "confidence": { "enum": ["low", "medium", "high"] },
          "disposition_route": {
            "enum": ["collect-external-evidence", "repair-simulator", "synthesis-to-spec"]
          }
        }
      }
    },
    "root_cause": {
      "type": "string",
      "enum": [
        "none",
        "execution",
        "evidence",
        "policy",
        "oracle",
        "cleanup",
        "calibration",
        "evaluator",
        "environment"
      ]
    },
    "earliest_failure": {
      "type": [
        "string",
        "null"
      ]
    },
    "residual_uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_route": {
      "type": "string",
      "minLength": 1
    }
  }
}
