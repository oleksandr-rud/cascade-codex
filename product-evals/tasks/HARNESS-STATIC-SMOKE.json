{
  "schema_version": 3,
  "id": "HARNESS-STATIC-SMOKE",
  "kind": "command",
  "driver": {
    "type": "direct-process",
    "adapter": "builtin-direct-process"
  },
  "required": true,
  "timeout_ms": 1000,
  "command": [
    "/usr/bin/printf",
    "cascade-static-ok"
  ],
  "process": {
