{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/campaign-task.schema.json",
  "title": "Cascade campaign task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "driver",
    "required",
    "timeout_ms",
    "oracle_ids"
  ],
  "properties": {
    "schema_version": {
      "enum": [1, 2, 3, 4, 5, 6, 7, 8]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]+$"
    },
    "kind": {
      "enum": [
        "command",
        "http",
        "terminal",
        "browser",
        "desktop",
        "mobile",
        "agent-response"
      ]
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "fake",
            "direct-process",
            "http-client",
            "pty",
            "playwright",
            "platform-automation",
            "computer-use",
            "agent-runtime"
          ]
        },
        "adapter": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]+$"
        }
      }
    },
    "required": {
      "type": "boolean"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "working_directory",
        "environment",
        "interactive",
        "network",
        "filesystem"
      ],
      "properties": {
        "working_directory": {
          "const": "task-root"
        },
        "environment": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/httpValue"
          }
        },
        "interactive": {
          "const": false
        },
        "network": {
          "const": "deny"
        },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write"],
          "properties": {
            "read": { "const": "host" },
            "write": { "const": "task-root" }
          }
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "working_directory",
        "environment",
        "network",
        "filesystem",
        "cols",
        "rows",
        "steps",
        "expected_exit_code",
        "evidence"
      ],
      "properties": {
        "working_directory": { "const": "task-root" },
        "environment": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/httpValue" }
        },
        "network": { "const": "deny" },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write"],
          "properties": {
            "read": { "const": "host" },
            "write": { "const": "task-root" }
          }
        },
        "cols": { "type": "integer", "minimum": 1, "maximum": 500 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 500 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/terminalWaitAction" },
              { "$ref": "#/$defs/terminalInputAction" },
              { "$ref": "#/$defs/terminalResizeAction" },
              { "$ref": "#/$defs/terminalSignalAction" },
              { "$ref": "#/$defs/terminalCaptureAction" }
            ]
          }
        },
        "expected_exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw_stream", "transcript", "final_screen"],
          "properties": {
            "raw_stream": { "const": true },
            "transcript": { "const": true },
            "final_screen": { "const": true }
          }
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_file",
        "profile",
        "network",
        "downloads",
        "uploads",
        "actions",
        "observation",
        "evidence"
      ],
      "properties": {
        "fixture_file": {
          "type": "string",
          "pattern": "^product-evals/simulations/harness/(?!.*(?:^|/)\\.\\.?(?:/|$)).+\\.html$"
        },
        "profile": { "const": "ephemeral" },
        "network": { "const": "deny" },
        "downloads": { "const": false },
        "uploads": { "const": false },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/browserFillAction" },
              { "$ref": "#/$defs/browserClickAction" },
              { "$ref": "#/$defs/browserNavigateAction" }
            ]
          }
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["locator", "expected_text"],
          "properties": {
            "locator": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "role"],
              "properties": {
                "kind": { "const": "role" },
                "role": { "type": "string", "minLength": 1 }
              }
            },
            "expected_text": { "type": "string", "minLength": 1 }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["screenshot", "trace"],
          "properties": {
            "screenshot": { "const": true },
            "trace": { "const": true }
          }
        }
      }
    },
    "desktop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "app",
        "environment",
        "network",
        "filesystem",
        "reset",
        "actions",
        "evidence"
      ],
      "properties": {
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["container_runtime", "image", "image_id", "platform", "fixture_root"],
          "properties": {
            "container_runtime": { "const": "docker" },
            "image": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._/-]*:[A-Za-z0-9._-]+$"
            },
            "image_id": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "platform": { "const": "linux/arm64" },
            "fixture_root": {
              "type": "string",
              "pattern": "^product-evals/simulations/harness/(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._/-]+/runtime$"
            }
          }
        },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "build"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "build": { "type": "string", "minLength": 1 }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display_server", "display", "resolution", "locale"],
          "properties": {
            "display_server": { "const": "xvfb" },
            "display": { "const": ":99" },
            "resolution": {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height", "scale"],
              "properties": {
                "width": { "type": "integer", "minimum": 320, "maximum": 7680 },
                "height": { "type": "integer", "minimum": 240, "maximum": 4320 },
                "scale": { "const": 1 }
              }
            },
            "locale": { "const": "C.UTF-8" }
          }
        },
        "network": { "const": "deny" },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "write"],
          "properties": {
            "root": { "const": "read-only" },
            "write": { "const": "task-root" }
          }
        },
        "reset": { "const": "container-remove" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/desktopLaunchAction" },
              { "$ref": "#/$defs/desktopTypeAction" },
              { "$ref": "#/$defs/desktopKeyAction" },
              { "$ref": "#/$defs/desktopWaitFileAction" },
              { "$ref": "#/$defs/desktopCaptureAction" }
            ]
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["screenshots", "result", "logs"],
          "properties": {
            "screenshots": { "const": true },
            "result": { "const": true },
            "logs": { "const": true }
          }
        }
      }
    },
    "mobile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "app", "network", "reset", "actions", "evidence"],
      "properties": {
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime", "device_id", "platform_version", "fixture_root"],
          "properties": {
            "runtime": { "enum": ["android-emulator", "ios-simulator"] },
            "device_id": { "type": "string", "minLength": 1 },
            "platform_version": { "type": "string", "minLength": 1 },
            "fixture_root": {
              "type": "string",
              "pattern": "^product-evals/simulations/harness/(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._/-]+/runtime$"
            }
          }
        },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "build"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "build": { "type": "string", "minLength": 1 }
          }
        },
        "network": { "const": "deny" },
        "reset": { "const": "snapshot-restore" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/mobileLaunchAction" },
              { "$ref": "#/$defs/mobileTapAction" },
              { "$ref": "#/$defs/mobileTypeAction" },
              { "$ref": "#/$defs/mobileKeyAction" },
              { "$ref": "#/$defs/mobileWaitTextAction" },
              { "$ref": "#/$defs/mobileCaptureAction" }
            ]
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["screenshots", "result", "logs"],
          "properties": {
            "screenshots": { "const": true },
            "result": { "const": true },
            "logs": { "const": true }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "runtime",
        "prompt_file",
        "input_file",
        "output_schema_file",
        "permissions",
        "budgets",
        "evaluation_profile",
        "source_blind"
      ],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "enum": ["explicit-instructions", "named-agent", "cascade-profile"]
            },
            "instruction_file": { "type": "string", "minLength": 1 },
            "agent_id": { "type": "string", "minLength": 1 },
            "profile_file": { "type": "string", "minLength": 1 }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider"],
          "properties": {
            "provider": { "enum": ["fixture", "codex"] },
            "fixture_response_file": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "reasoning_effort": { "enum": ["low", "medium", "high"] }
          }
        },
        "prompt_file": { "type": "string", "minLength": 1 },
        "input_file": { "type": "string", "minLength": 1 },
        "output_schema_file": { "type": "string", "minLength": 1 },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filesystem", "network", "tools"],
          "properties": {
            "filesystem": { "const": "read-only" },
            "network": { "const": "deny" },
            "tools": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_output_bytes", "max_tool_calls", "max_tokens"],
          "properties": {
            "max_output_bytes": { "type": "integer", "minimum": 1 },
            "max_tool_calls": { "type": "integer", "minimum": 0 },
            "max_tokens": { "type": "integer", "minimum": 1 }
          }
        },
        "evaluation_profile": {
          "enum": ["response-contract-v1", "cascade-route-and-trace-v1"]
        },
        "source_blind": { "const": true }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "url"
      ],
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/httpValue"
          }
        },
        "body": {
          "$ref": "#/$defs/httpValue"
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "oracle_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "policy_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "publicLiteral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "public-literal" },
        "value": { "type": "string" }
      }
    },
    "secretReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference_id", "immutable_version"],
      "properties": {
        "kind": { "const": "secret-reference" },
        "reference_id": { "type": "string", "minLength": 1 },
        "immutable_version": { "type": "string", "minLength": 1 },
        "lease_id": { "type": "string", "minLength": 1 }
      }
    },
    "httpValue": {
      "oneOf": [
        { "$ref": "#/$defs/publicLiteral" },
        { "$ref": "#/$defs/secretReference" }
      ]
    },
    "desktopLaunchAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "app_id", "window_title"],
      "properties": {
        "type": { "const": "desktop-launch" },
        "app_id": { "type": "string", "minLength": 1 },
        "window_title": { "type": "string", "minLength": 1 }
      }
    },
    "desktopTypeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "desktop-type" },
        "value": { "$ref": "#/$defs/publicLiteral" }
      }
    },
    "desktopKeyAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key"],
      "properties": {
        "type": { "const": "desktop-key" },
        "key": { "type": "string", "pattern": "^[A-Za-z0-9_+-]{1,64}$" }
      }
    },
    "desktopWaitFileAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "file", "timeout_ms"],
      "properties": {
        "type": { "const": "desktop-wait-file" },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 }
      }
    },
    "desktopCaptureAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label"],
      "properties": {
        "type": { "const": "desktop-capture" },
        "label": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
      }
    },
    "mobileLaunchAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "app_id"],
      "properties": {
        "type": { "const": "mobile-launch" },
        "app_id": { "type": "string", "minLength": 1 }
      }
    },
    "mobileTapAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "x", "y"],
      "properties": {
        "type": { "const": "mobile-tap" },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      }
    },
    "mobileTypeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "mobile-type" },
        "value": { "$ref": "#/$defs/publicLiteral" }
      }
    },
    "mobileKeyAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key"],
      "properties": {
        "type": { "const": "mobile-key" },
        "key": { "type": "string", "pattern": "^[A-Za-z0-9_+-]{1,64}$" }
      }
    },
    "mobileWaitTextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text", "timeout_ms"],
      "properties": {
        "type": { "const": "mobile-wait-text" },
        "text": { "type": "string", "minLength": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 }
      }
    },
    "mobileCaptureAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label"],
      "properties": {
        "type": { "const": "mobile-capture" },
        "label": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
      }
    },
    "browserFillAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "locator", "value"],
      "properties": {
        "type": { "const": "browser-fill" },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "label" },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "browserClickAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "locator"],
      "properties": {
        "type": { "const": "browser-click" },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "role", "name"],
          "properties": {
            "kind": { "const": "role" },
            "role": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "browserNavigateAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": { "const": "browser-navigate" },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    },
    "terminalWaitAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text", "timeout_ms"],
      "properties": {
        "type": { "const": "terminal-wait" },
        "text": { "type": "string", "minLength": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 }
      }
    },
    "terminalInputAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value", "append_enter"],
      "properties": {
        "type": { "const": "terminal-input" },
        "value": { "$ref": "#/$defs/httpValue" },
        "append_enter": { "type": "boolean" }
      }
    },
    "terminalResizeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "cols", "rows"],
      "properties": {
        "type": { "const": "terminal-resize" },
        "cols": { "type": "integer", "minimum": 1, "maximum": 500 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 500 }
      }
    },
    "terminalSignalAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "signal"],
      "properties": {
        "type": { "const": "terminal-signal" },
        "signal": { "enum": ["SIGINT", "SIGTERM"] }
      }
    },
    "terminalCaptureAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label"],
      "properties": {
        "type": { "const": "terminal-capture" },
        "label": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "driver": {
            "properties": { "type": { "const": "pty" } },
            "required": ["type"]
          }
        },
        "required": ["driver"]
      },
      "then": {
        "required": ["command", "terminal"],
        "properties": { "schema_version": { "const": 6 } }
      }
    },
    {
      "if": {
        "properties": {
          "driver": {
            "properties": { "type": { "const": "direct-process" } },
            "required": ["type"]
          }
        },
        "required": ["driver"]
      },
      "then": {
        "required": ["command", "process"],
        "properties": { "schema_version": { "const": 3 } }
      }
    },
    {
      "if": {
        "properties": {
          "driver": {
            "properties": { "type": { "const": "http-client" } },
            "required": ["type"]
          }
        },
        "required": ["driver"]
      },
      "then": {
        "properties": { "schema_version": { "const": 2 } }
      }
    },
    {
      "if": {
        "properties": {
          "driver": {
            "properties": { "type": { "const": "playwright" } },
            "required": ["type"]
          }
        },
        "required": ["driver"]
      },
      "then": {
        "required": ["browser"],
        "properties": { "schema_version": { "const": 4 } }
      }
    },
    {
      "if": {
        "properties": {
          "driver": {
            "properties": { "type": { "const": "agent-runtime" } },
            "required": ["type"]
          }
        },
        "required": ["driver"]
      },
      "then": {
        "required": ["agent", "inputs"],
