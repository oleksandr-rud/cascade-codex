{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/simulation-calibration.schema.json",
  "title": "Cascade simulation calibration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "simulation_id",
    "dataset_id",
    "treatment_ids",
    "metric_ids",
    "simulated_scores_file",
    "reference_scores_file",
    "reference",
    "thresholds",
    "required_slices",
    "staleness_days",
    "framework_fixture"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "simulation_id": {
      "type": "string"
    },
    "dataset_id": {
      "type": "string"
    },
    "treatment_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "metric_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "simulated_scores_file": {
      "type": "string",
      "pattern": "^product-evals/calibrations/fixtures/.+\\.json$"
    },
    "reference_scores_file": {
      "type": "string",
      "pattern": "^product-evals/calibrations/fixtures/.+\\.json$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label_digest",
        "reference_window_end",
        "reviewer_identity"
      ],
      "properties": {
        "kind": {
          "enum": [
            "framework-fixture",
            "expert-labelled",
            "production"
          ]
        },
        "label_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference_window_end": {
          "type": "string",
          "format": "date-time"
        },
        "reviewer_identity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_samples",
        "minimum_rank_correlation",
        "minimum_linear_correlation",
        "minimum_human_agreement"
      ],
      "properties": {
        "minimum_samples": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_rank_correlation": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "minimum_linear_correlation": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "minimum_human_agreement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "required_slices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "staleness_days": {
      "type": "integer",
      "minimum": 1
    },
    "framework_fixture": {
      "type": "boolean"
    }
  }
}
