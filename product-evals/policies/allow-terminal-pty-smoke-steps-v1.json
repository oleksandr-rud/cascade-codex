{
  "schema_version": 2,
  "id": "allow-terminal-pty-smoke-steps-v1",
  "version": "2.0.0",
  "effect": "ALLOW",
  "scope": {
    "campaign_ids": ["terminal-pty-smoke"],
    "task_ids": ["TERMINAL-PTY-SMOKE"],
    "task_kinds": ["terminal"],
    "driver_types": ["pty"],
    "action_types": [
      "terminal-wait",
      "terminal-resize",
      "terminal-input",
      "terminal-capture"
    ]
  },
  "budgets": {
    "required_dimensions": ["action_count", "output_bytes"],
    "max_actions": 6,
    "max_output_bytes": 8192
  },
  "redaction_profile": "no-secrets-v1",
  "reason": "Allow only the bounded wait, resize, public input, and capture steps of the terminal prompt fixture."
}
