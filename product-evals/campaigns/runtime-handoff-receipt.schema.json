{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/runtime-handoff-receipt.v1.schema.json",
  "title": "Cascade runtime handoff receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "receipt_id",
    "run_id",
    "campaign_id",
    "task_id",
    "terminal_status",
    "task_result_digest",
    "source_manifest_digest",
    "evidence_manifest_digest",
    "recovery_receipt_digest",
    "cleanup_receipt_digest",
    "retry_lineage",
    "required_inputs",
    "artifact_references",
    "proposed_next_owner",
    "proposed_next_gate",
    "producer_principal",
    "receiver_principal",
    "disposition",
    "offer_receipt_digest",
    "receiving_receipt_digest",
    "reason",
    "superseded_receipt_digest",
    "changed_bound_inputs",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "const": "runtime-handoff-receipt" },
    "receipt_id": { "$ref": "#/$defs/identifier" },
    "run_id": { "$ref": "#/$defs/identifier" },
    "campaign_id": { "$ref": "#/$defs/identifier" },
    "task_id": { "$ref": "#/$defs/identifier" },
    "terminal_status": { "$ref": "#/$defs/identifier" },
    "task_result_digest": { "$ref": "#/$defs/digest" },
    "source_manifest_digest": { "$ref": "#/$defs/digest" },
    "evidence_manifest_digest": { "$ref": "#/$defs/digest" },
    "recovery_receipt_digest": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "cleanup_receipt_digest": { "$ref": "#/$defs/digest" },
    "retry_lineage": { "$ref": "#/$defs/retryLineage" },
    "required_inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifactPath" }
    },
    "artifact_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifactReference" }
    },
    "proposed_next_owner": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "proposed_next_gate": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "producer_principal": { "$ref": "#/$defs/operatorPrincipal" },
    "receiver_principal": {
      "oneOf": [
        { "$ref": "#/$defs/receiverPrincipal" },
        { "type": "null" }
      ]
    },
    "disposition": {
      "enum": ["PENDING", "ACCEPTED", "REJECTED", "STALE", "NOT_APPLICABLE"]
    },
    "offer_receipt_digest": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "receiving_receipt_digest": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]+$"
    },
    "superseded_receipt_digest": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "changed_bound_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "artifact_references",
          "cleanup_receipt_digest",
          "evidence_manifest_digest",
          "proposed_next_gate",
          "proposed_next_owner",
          "receiver_principal",
          "recovery_receipt_digest",
          "retry_lineage",
          "source_manifest_digest",
          "terminal_status",
          "task_result_digest"
        ]
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "proposed_next_owner": { "type": "null" } },
        "required": ["proposed_next_owner"]
      },
      "then": { "properties": { "proposed_next_gate": { "type": "null" } } },
      "else": { "properties": { "proposed_next_gate": { "$ref": "#/$defs/identifier" } } }
    },
    {
      "if": {
        "properties": { "disposition": { "const": "NOT_APPLICABLE" } },
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "receiver_principal": { "type": "null" },
          "proposed_next_owner": { "type": "null" },
          "proposed_next_gate": { "type": "null" },
          "superseded_receipt_digest": { "type": "null" },
          "offer_receipt_digest": { "type": "null" },
          "receiving_receipt_digest": { "type": "null" },
          "changed_bound_inputs": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": { "enum": ["PENDING", "ACCEPTED", "REJECTED"] }
        },
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "receiver_principal": { "$ref": "#/$defs/receiverPrincipal" },
          "proposed_next_owner": { "$ref": "#/$defs/identifier" },
          "proposed_next_gate": { "$ref": "#/$defs/identifier" },
          "superseded_receipt_digest": { "type": "null" },
          "changed_bound_inputs": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "disposition": { "enum": ["ACCEPTED", "REJECTED"] } },
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "offer_receipt_digest": { "$ref": "#/$defs/digest" },
          "receiving_receipt_digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    {
      "if": {
        "properties": { "disposition": { "const": "STALE" } },
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "superseded_receipt_digest": { "$ref": "#/$defs/digest" },
          "changed_bound_inputs": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,1023}$"
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/artifactPath" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "session_id", "subject"],
      "properties": {
        "role": {
          "enum": [
            "simulation-operator",
            "simulation-evaluator",
            "campaign-aggregator",
            "target-actor",
            "simulator",
            "simulation-recovery",
            "harness-evaluator"
          ]
        },
        "session_id": { "$ref": "#/$defs/identifier" },
        "subject": { "$ref": "#/$defs/identifier" }
      }
    },
    "operatorPrincipal": {
      "allOf": [
        { "$ref": "#/$defs/principal" },
        { "properties": { "role": { "const": "simulation-operator" } } }
      ]
    },
    "receiverPrincipal": {
      "allOf": [
        { "$ref": "#/$defs/principal" },
        {
          "properties": {
            "role": {
              "enum": [
                "simulation-evaluator",
                "campaign-aggregator",
                "target-actor",
                "simulator",
                "simulation-recovery",
                "harness-evaluator"
              ]
            }
          }
        }
      ]
    },
    "retryLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "parent_run_id", "parent_handoff_receipt_digest"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "parent_run_id": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "parent_handoff_receipt_digest": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "attempt": { "const": 1 } },
            "required": ["attempt"]
          },
          "then": {
            "properties": {
              "parent_run_id": { "type": "null" },
              "parent_handoff_receipt_digest": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "parent_run_id": { "$ref": "#/$defs/identifier" },
              "parent_handoff_receipt_digest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      ]
    }
  }
}
