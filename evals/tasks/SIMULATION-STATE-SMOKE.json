{
  "schema_version": 1,
  "id": "SIMULATION-STATE-SMOKE",
  "kind": "agent-response",
  "driver": {
    "type": "fake",
    "adapter": "stateful-framework-fixture-v1"
  },
  "required": true,
  "timeout_ms": 1000,
  "actions": [
    {
      "type": "assert",
      "path": "account.status",
      "value": "pending"
    },
    {
      "type": "set",
      "path": "account.status",
      "value": "resolved"
    },
    {
      "type": "increment",
      "path": "account.attempts",
      "amount": 1
    },
    {
      "type": "assert",
      "path": "account.attempts",
      "value": 1
    }
  ],
  "oracle_ids": [
    "account-resolved-v1",
    "account-attempt-recorded-v1"
  ],
  "policy_ids": [
    "allow-fixture-state-actions-v1"
  ]
}
