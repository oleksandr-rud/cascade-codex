{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/campaign-task.schema.json",
  "title": "Cascade campaign task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "command"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]+$"
    },
    "kind": {
      "enum": [
        "command",
        "browser",
        "agent-response"
      ]
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cwd": {
      "type": "string"
    },
    "required": {
      "type": "boolean"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1
    },
    "expected_exit_code": {
      "type": "integer"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
