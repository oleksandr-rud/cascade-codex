{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/campaign-task.schema.json",
  "title": "Cascade campaign task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "driver",
    "required",
    "timeout_ms",
    "oracle_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]+$"
    },
    "kind": {
      "enum": [
        "command",
        "terminal",
        "browser",
        "desktop",
        "mobile",
        "agent-response"
      ]
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "fake",
            "direct-process",
            "pty",
            "playwright",
            "platform-automation",
            "computer-use",
            "agent-runtime"
          ]
        },
        "adapter": {
          "type": "string"
        }
      }
    },
    "required": {
      "type": "boolean"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "oracle_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "policy_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
