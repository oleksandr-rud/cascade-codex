{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/campaign.schema.json",
  "title": "Cascade execution campaign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "purpose",
    "owner_lane",
    "tier",
    "evaluation_profile_file",
    "simulation_file",
    "task_files",
    "claim_files",
    "policy_files",
    "oracle_files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "owner_lane": {
      "type": "string",
      "pattern": "^W-[0-9]{3}$"
    },
    "tier": {
      "enum": [
        "deterministic-fixture",
        "controlled-integration",
        "platform-canary",
        "semantic-evaluation"
      ]
    },
    "evaluation_profile_file": {
      "type": "string",
      "pattern": "^evals/rubrics/.+\\.json$"
    },
    "simulation_file": {
      "type": "string",
      "pattern": "^evals/simulations/.+/manifest\\.json$"
    },
    "task_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^evals/tasks/.+\\.json$"
      }
    },
    "claim_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^evals/claims/.+\\.json$"
      }
    },
    "policy_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^evals/policies/.+\\.json$"
      }
    },
    "oracle_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^evals/oracles/.+\\.json$"
      }
    }
  }
}
