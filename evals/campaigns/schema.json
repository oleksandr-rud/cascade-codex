{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/campaign.schema.json",
  "title": "Cascade execution campaign",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "purpose",
    "mode",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "mode": {
      "enum": [
        "deterministic",
        "agent"
      ]
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "../tasks/schema.json"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_file"
            ],
            "properties": {
              "task_file": {
                "type": "string",
                "pattern": "^evals/tasks/.+\\.json$"
              }
            }
          }
        ]
      }
    }
  }
}
