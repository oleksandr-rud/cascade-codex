{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/simulation-policy.schema.json",
  "title": "Cascade simulation policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "effect",
    "action_types",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "effect": {
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_CONFIRMATION"
      ]
    },
    "action_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
