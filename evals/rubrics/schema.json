{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/simulation-rubric.schema.json",
  "title": "Cascade simulation semantic rubric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "criteria",
    "judge_profile",
    "human_calibration_required"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "judge_profile": {
      "type": "string",
      "minLength": 1
    },
    "human_calibration_required": {
      "type": "boolean"
    }
  }
}
