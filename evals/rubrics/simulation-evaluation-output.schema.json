{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cascade Codex simulation evaluation output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "run_id",
    "campaign_id",
    "source_manifest_digest",
    "execution_receipt_digest",
    "evaluation_input_digest",
    "input_manifest_digest",
    "evaluator_identity",
    "status",
    "mechanical_gate_status",
    "claim_assessments",
    "root_cause",
    "earliest_failure",
    "residual_uncertainty",
    "next_route"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "source_manifest_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "execution_receipt_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluation_input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_manifest_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluator_identity": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "mechanical_gate_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "claim_assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "status",
          "reason",
          "evidence"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "SUPPORTED",
              "PARTIALLY_SUPPORTED",
              "UNSUPPORTED",
              "CONFLICTING",
              "BLOCKED",
              "NOT_RUN",
              "INVALID"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "root_cause": {
      "type": "string",
      "enum": [
        "none",
        "execution",
        "evidence",
        "policy",
        "oracle",
        "cleanup",
        "calibration",
        "evaluator",
        "environment"
      ]
    },
    "earliest_failure": {
      "type": [
        "string",
        "null"
      ]
    },
    "residual_uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_route": {
      "type": "string",
      "minLength": 1
    }
  }
}
