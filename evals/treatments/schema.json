{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/simulation-treatment.schema.json",
  "title": "Cascade simulation treatment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "baseline",
    "target"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "baseline": {
      "type": "boolean"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision",
        "model",
        "prompt_digest",
        "tool_digest",
        "harness_digest"
      ],
      "properties": {
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "prompt_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tool_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "harness_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
