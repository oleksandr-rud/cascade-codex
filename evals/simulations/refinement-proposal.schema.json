{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/refinement-proposal.schema.json",
  "title": "Cascade product-persona refinement proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "run_id",
    "campaign_id",
    "evaluation_id",
    "persona",
    "derivation",
    "proposal_type",
    "target_field",
    "summary",
    "rationale",
    "recommended_change",
    "evidence_paths",
    "confidence",
    "disposition_route",
    "external_evidence_required",
    "human_review_required",
    "direct_persona_mutation_allowed",
    "status",
    "proposed_by",
    "created_at",
    "promotion_blockers"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "proposal_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "run_id": { "type": "string", "minLength": 1 },
    "campaign_id": { "type": "string", "minLength": 1 },
    "evaluation_id": { "type": "string", "minLength": 1 },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persona_id", "revision", "path", "sha256"],
      "properties": {
        "persona_id": { "type": "string", "pattern": "^P-[0-9]{3}$" },
        "revision": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "pattern": "^docs/product/personas/.+\\.md$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "path": { "type": "string", "pattern": "^evals/simulations/.+/derivations/.+\\.json$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "proposal_type": {
      "enum": [
        "missing-dimension",
        "stale-assumption",
        "contradiction",
        "journey-gap",
        "scenario-gap",
        "requirement-gap",
        "accessibility-gap",
        "permission-gap",
        "simulator-defect",
        "research-question"
      ]
    },
    "target_field": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "recommended_change": { "type": "string", "minLength": 1 },
    "evidence_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "disposition_route": {
      "enum": ["collect-external-evidence", "repair-simulator", "synthesis-to-spec"]
    },
    "external_evidence_required": { "const": true },
    "human_review_required": { "const": true },
    "direct_persona_mutation_allowed": { "const": false },
    "status": { "const": "PROPOSED" },
    "proposed_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "promotion_blockers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
