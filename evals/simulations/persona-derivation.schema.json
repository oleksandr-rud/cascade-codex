{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/persona-derivation.schema.json",
  "title": "Cascade product-persona derivation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "simulation_id",
    "population_id",
    "mode",
    "product_personas",
    "dimensions",
    "invariants",
    "mutation_axes",
    "actors",
    "generator",
    "evidence_sources",
    "review"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "simulation_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "population_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "mode": {
      "enum": ["representative", "coverage", "stress", "counterfactual"]
    },
    "product_personas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/personaReference" }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "source_persona_ids",
          "confidence",
          "uncertainty",
          "permitted_variation"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
          "description": { "type": "string", "minLength": 1 },
          "source_persona_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^P-[0-9]{3}$" }
          },
          "confidence": { "enum": ["low", "medium", "high"] },
          "uncertainty": { "type": "string", "minLength": 1 },
          "permitted_variation": { "type": "boolean" }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "mutation_axes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "values", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
          "values": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/actor" }
    },
    "generator": { "$ref": "#/$defs/generator" },
    "evidence_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "reference", "minimized"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
          "kind": {
            "enum": [
              "research",
              "feedback",
              "behavioral-data",
              "expert-review",
              "product-spec",
              "framework-fixture"
            ]
          },
          "reference": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "minimized": { "const": true }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer_identity", "reviewed_at"],
      "properties": {
        "status": { "enum": ["draft", "reviewed", "approved", "superseded"] },
        "reviewer_identity": { "type": ["string", "null"] },
        "reviewed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "personaReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persona_id", "revision", "path", "sha256"],
      "properties": {
        "persona_id": { "type": "string", "pattern": "^P-[0-9]{3}$" },
        "revision": { "type": "integer", "minimum": 1 },
        "path": {
          "type": "string",
          "pattern": "^docs/product/personas/.+\\.md$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version", "input_digest"],
      "properties": {
        "kind": { "enum": ["deterministic-manifest", "model-backed"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "input_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "model": { "type": "string", "minLength": 1 },
        "prompt_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "tool_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "model-backed" } } },
          "then": { "required": ["model", "prompt_digest", "tool_digest"] }
        }
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "weight",
        "actor_class",
        "persona_ids",
        "goals",
        "invariants",
        "knowledge",
        "uncertainty",
        "decision_policy",
        "communication_policy",
        "state_memory",
        "friction_behaviors",
        "abstention",
        "slices"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "actor_class": {
          "enum": ["representative", "variant", "edge", "counterfactual"]
        },
        "persona_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^P-[0-9]{3}$" }
        },
        "goals": { "$ref": "#/$defs/nonEmptyStrings" },
        "invariants": { "$ref": "#/$defs/nonEmptyStrings" },
        "knowledge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["known", "unknown"],
          "properties": {
            "known": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "unknown": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "uncertainty": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "decision_policy": { "type": "object" },
        "communication_policy": { "type": "object" },
        "state_memory": { "type": "object" },
        "friction_behaviors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "abstention": { "type": "object" },
        "slices": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
