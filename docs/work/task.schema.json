{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/work-task.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "title", "status", "owner", "product_task", "updated_at", "next_action", "validation"],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "pattern": "^T-(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2,8})$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "enum": ["PLANNED", "READY", "IN_PROGRESS", "IN_REVIEW", "BLOCKED", "COMPLETE", "CANCELLED"] },
    "owner": { "type": "string", "minLength": 1, "maxLength": 100 },
    "product_task": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "reference"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 100 },
            "reference": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        }
      ]
    },
    "updated_at": { "type": "string", "format": "date" },
    "next_action": { "type": ["string", "null"], "minLength": 1, "maxLength": 1000 },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "required", "result", "detail"],
        "properties": {
          "check": { "type": "string", "minLength": 1, "maxLength": 300 },
          "required": { "type": "boolean" },
          "result": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "NOT_APPLICABLE"] },
          "detail": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    }
  }
}
