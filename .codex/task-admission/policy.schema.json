{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/task-admission-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "bundle_version", "policies"],
  "properties": {
    "schema_version": { "const": 1 },
    "bundle_id": { "const": "cascade-core" },
    "bundle_version": { "type": "integer", "minimum": 1 },
    "policies": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version", "priority", "match_all", "match_any", "required_controls", "forbidden_controls", "minimum_route", "minimum_assurance", "minimum_evidence", "approval", "conflict_set", "rationale", "invalidation"],
        "properties": {
          "id": { "type": "string", "pattern": "^TAP-[0-9]{3}$" },
          "version": { "type": "integer", "minimum": 1 },
          "priority": { "enum": ["HARD_DENY", "APPROVAL", "HAZARD", "ASSURANCE", "TOPOLOGY", "OPTIONAL"] },
          "match_all": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "match_any": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "required_controls": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "forbidden_controls": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "minimum_route": { "type": ["string", "null"] },
          "minimum_assurance": { "type": ["string", "null"] },
          "minimum_evidence": { "type": ["string", "null"] },
          "approval": { "type": ["string", "null"] },
          "conflict_set": { "type": ["string", "null"] },
          "rationale": { "type": "string", "minLength": 1 },
          "invalidation": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
