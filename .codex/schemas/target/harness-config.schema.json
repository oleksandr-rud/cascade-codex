{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/harness-config.schema.json",
  "title": "Cascade target harness configuration",
  "type": "object",
  "required": [
    "project",
    "models",
    "paths",
    "validation_commands",
    "routing",
    "functional_acceptance",
    "memory",
    "patterns"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "primary_users",
        "stack"
      ]
    },
    "models": {
      "type": "object",
      "required": [
        "default",
        "planning",
        "judged_evaluation",
        "subagent_execution",
        "read_heavy"
      ],
      "properties": {
        "default": {
          "type": "string"
        },
        "planning": {
          "type": "string"
        },
        "judged_evaluation": {
          "type": "string"
        },
        "subagent_execution": {
          "type": "string"
        },
        "read_heavy": {
          "type": "string"
        }
      },
      "not": {
        "required": [
          "golden_evaluation"
        ]
      }
    },
    "paths": {
      "type": "object",
      "required": [
        "source_roots",
        "test_roots",
        "app_entrypoints",
        "public_contracts",
        "docs_root",
        "structure",
        "glossary",
        "active_work",
        "patterns",
        "pattern_context_builder",
        "task_admission_schema",
        "task_admission_policy",
        "task_admission_hook",
        "task_admission_runner",
        "plugin_capability_catalog",
        "workspace_artifact_registry",
        "workspace_mcp_runner"
      ],
      "properties": {
        "product_catalog": {
          "const": "docs/product/catalog.yaml"
        },
        "product_catalog_schema": {
          "const": "docs/product/catalog.schema.json"
        },
        "product_brief_schema": {
          "const": "docs/specs/brief-manifest.schema.json"
        },
        "product_brief_runner": {
          "enum": ["scripts/cascade/briefs.ts", ".codex/runtime/cascade.js"]
        },
        "task_admission_schema": {
          "const": ".codex/task-admission/task-envelope.schema.json"
        },
        "task_admission_policy": {
          "const": ".codex/task-admission/policies/core.yaml"
        },
        "task_admission_hook": {
          "const": ".codex/hooks.json"
        },
        "task_admission_runner": {
          "enum": ["scripts/cascade/admission.ts", ".codex/runtime/cascade.js"]
        },
        "plugin_capability_catalog": {
          "const": ".codex/plugin-capabilities.generated.json"
        },
        "workspace_artifact_registry": {
          "const": ".codex/artifact-destinations.json"
        },
        "workspace_mcp_runner": {
          "enum": ["scripts/cascade/workspace-mcp.ts", ".codex/runtime/workspace-mcp.js"]
        }
      }
    },
    "validation_commands": {
      "type": "object",
      "required": [
        "install",
        "targeted",
        "unit",
        "lint",
        "typecheck",
        "build",
        "functional",
        "e2e"
      ]
    },
    "routing": {
      "type": "object",
      "required": ["admission", "non_atomic_fallback_path"],
      "not": { "required": ["new_task_path"] }
    },
    "functional_acceptance": {
      "type": "object"
    },
    "memory": {
      "type": "object"
    },
    "patterns": {
      "type": "object"
    }
  }
}
