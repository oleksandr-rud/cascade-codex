{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline", "candidate", "receipt_schema_digest", "cases", "profiles", "models", "author_context_ids", "minimum_gain", "receipts"],
  "properties": {
    "schema_version": {"const": "improvement-cycle.v1"},
    "baseline": {"$ref": "#/$defs/file"},
    "candidate": {"$ref": "#/$defs/file"},
    "receipt_schema_digest": {"$ref": "#/$defs/digest"},
    "cases": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["id", "split", "source"], "properties": {"id": {"type": "string", "minLength": 1}, "split": {"enum": ["FAILURE", "REGRESSION", "HELD_OUT"]}, "source": {"$ref": "#/$defs/file"}}}},
    "profiles": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}}}},
    "models": {"type": "object"},
    "author_context_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "minimum_gain": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "receipts": {"type": "array", "minItems": 4, "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["variant", "case_id", "path", "sha256", "bundle_sha256"], "properties": {"variant": {"enum": ["baseline", "candidate"]}, "case_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}, "bundle_sha256": {"$ref": "#/$defs/digest"}}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}}
  }
}
