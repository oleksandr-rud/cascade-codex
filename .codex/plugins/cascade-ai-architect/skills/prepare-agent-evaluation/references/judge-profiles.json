{
  "profiles_version": "1.1.0",
  "rating_scale": {"minimum": 0, "maximum": 4, "integer_only": true},
  "acceptance": {
    "minimum_normalized_score": 0.95,
    "minimum_dimension_rating": 3,
    "conservative_score": "min(outcome,trajectory)",
    "both_profiles_required": true
  },
  "profiles": [
    {
      "id": "architecture-outcome",
      "version": "1.0.0",
      "rubric": "rubrics/outcome-v1.md",
      "independent": true,
      "dimensions": [
        {"id": "task-fit", "weight": 25},
        {"id": "capability-coverage", "weight": 25},
        {"id": "behavioral-completeness", "weight": 20},
        {"id": "safety-operability", "weight": 20},
        {"id": "minimality-actionability", "weight": 10}
      ]
    },
    {
      "id": "architecture-trajectory",
      "version": "1.0.0",
      "rubric": "rubrics/trajectory-v1.md",
      "independent": true,
      "dimensions": [
        {"id": "source-selection-grounding", "weight": 20},
        {"id": "source-capability-derivation", "weight": 25},
        {"id": "cluster-boundary-quality", "weight": 20},
        {"id": "building-block-topology", "weight": 20},
        {"id": "adaptation-efficiency", "weight": 15}
      ]
    }
  ],
  "leakage_exclusions": [
    "eligibility verdict",
    "acceptance threshold",
    "expected answer or human label",
    "prior or peer score",
    "other judge response",
    "candidate promotion decision"
  ]
}
