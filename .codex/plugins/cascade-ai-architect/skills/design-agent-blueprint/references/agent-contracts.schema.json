{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cascade:claims-actions:1",
  "title": "Claims, action requests, admission and role runtime contracts",
  "$defs": {
    "JsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "Claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        },
        "support": {
          "enum": [
            "REPORTED",
            "OBSERVED",
            "INFERRED",
            "UNCERTAIN",
            "CONFLICTING"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "minItems": 0,
          "maxItems": 16
        },
        "uncertainty": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          ]
        }
      },
      "required": [
        "id",
        "subject",
        "predicate",
        "value",
        "support",
        "confidence",
        "evidence_refs",
        "uncertainty"
      ],
      "additionalProperties": false
    },
    "Action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "kind": {
              "const": "RESEARCH"
            },
            "claim_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "minItems": 0,
              "maxItems": 32
            },
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "minItems": 1,
              "maxItems": 8
            }
          },
          "required": [
            "id",
            "kind",
            "claim_refs",
            "query",
            "source_ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "kind": {
              "const": "COMPOSE"
            },
            "claim_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "minItems": 0,
              "maxItems": 32
            },
            "goal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "required": [
            "id",
            "kind",
            "claim_refs",
            "goal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "kind": {
              "const": "CLARIFY"
            },
            "claim_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "minItems": 0,
              "maxItems": 32
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "required": [
            "id",
            "kind",
            "claim_refs",
            "question"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "kind": {
              "const": "STOP"
            },
            "claim_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "minItems": 0,
              "maxItems": 32
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "required": [
            "id",
            "kind",
            "claim_refs",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Analysis": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "analysis.v1"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "schema_version",
        "claims",
        "actions",
        "uncertainties"
      ],
      "additionalProperties": false
    },
    "Observation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "kind": {
          "enum": [
            "USER",
            "TOOL",
            "RESEARCH",
            "STATE",
            "REFERENCE"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32000
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "required": [
        "id",
        "kind",
        "content",
        "source_id"
      ],
      "additionalProperties": false
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "status": {
          "enum": [
            "ACTIVE",
            "WAITING_INPUT",
            "COMPLETED",
            "CANCELLED"
          ]
        },
        "response": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Response"
            }
          ]
        }
      },
      "required": [
        "request_id",
        "scope_id",
        "revision",
        "task",
        "observations",
        "status",
        "response"
      ],
      "additionalProperties": false
    },
    "Request": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "required": [
        "request_id",
        "scope_id"
      ],
      "additionalProperties": false
    },
    "ResearchResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "research.v1"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32000
              }
            },
            "required": [
              "id",
              "source_id",
              "content"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 32
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "schema_version",
        "observations",
        "uncertainties"
      ],
      "additionalProperties": false
    },
    "Response": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "response.v1"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32000
        },
        "claim_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "schema_version",
        "content",
        "claim_refs"
      ],
      "additionalProperties": false
    },
    "Authorization": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "request_digest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "allowed",
        "operation",
        "request_id",
        "scope_id",
        "revision",
        "request_digest"
      ],
      "additionalProperties": false
    },
    "CommitReceipt": {
      "type": "object",
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "before_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "after_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "request_digest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "receipt_id",
        "request_id",
        "scope_id",
        "before_revision",
        "after_revision",
        "operation",
        "request_digest"
      ],
      "additionalProperties": false
    },
    "Limits": {
      "type": "object",
      "properties": {
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "max_research_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "wall_time_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        }
      },
      "required": [
        "max_rounds",
        "max_research_calls",
        "wall_time_ms"
      ],
      "additionalProperties": false
    },
    "Catalog": {
      "type": "object",
      "properties": {
        "predicates": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "minItems": 1,
          "maxItems": 128
        }
      },
      "required": [
        "predicates",
        "sources",
        "subjects"
      ],
      "additionalProperties": false
    },
    "ResponseCheck": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "response-check.v1"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "response_digest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "analysis_digest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "judge_context_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "evidence_receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "UNRESOLVED"
          ]
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "scope_id",
        "revision",
        "response_digest",
        "analysis_digest",
        "judge_context_id",
        "evidence_receipt_id",
        "verdict"
      ],
      "additionalProperties": false
    }
  }
}
