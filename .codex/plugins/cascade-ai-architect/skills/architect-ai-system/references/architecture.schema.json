{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/ai-architecture-packet-1.0.json",
  "title": "Cascade AI architecture packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_slug",
    "packet_status",
    "source_snapshot",
    "system",
    "capabilities",
    "clusters",
    "topology",
    "behavior_blocks",
    "components",
    "dependencies",
    "gaps",
    "decisions"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "packet_slug": {"$ref": "#/$defs/slug"},
    "packet_status": {"enum": ["CANDIDATE", "GAP", "BLOCKED", "VALIDATED"]},
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiled_at", "sources"],
      "properties": {
        "compiled_at": {"type": "string", "minLength": 1},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["locator", "kind", "authority", "digest"],
            "properties": {
              "locator": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "minLength": 1},
              "authority": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "objective", "represented_users", "non_goals", "autonomy", "risk_level", "completion_condition"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "represented_users": {"$ref": "#/$defs/nonEmptyStrings"},
        "non_goals": {"$ref": "#/$defs/nonEmptyStrings"},
        "autonomy": {"type": "string", "minLength": 1},
        "risk_level": {"enum": ["low", "medium", "high", "critical"]},
        "completion_condition": {"type": "string", "minLength": 1}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    },
    "clusters": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cluster"}
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rationale", "rejected_alternatives"],
      "properties": {
        "kind": {"enum": ["deterministic_workflow", "single_agent", "single_agent_with_skills", "model_pipeline", "manager_with_specialists", "decentralized_handoffs", "evaluator_optimizer"]},
        "rationale": {"type": "string", "minLength": 1},
        "rejected_alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reason"],
            "properties": {"kind": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "behavior_blocks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "input_contract", "output_contract", "loop", "state", "context", "memory", "tools", "skills", "roles", "failure", "observability", "evaluation", "rollout"],
      "properties": {
        "objective": {"$ref": "#/$defs/objectiveBlock"},
        "input_contract": {"$ref": "#/$defs/inputContractBlock"},
        "output_contract": {"$ref": "#/$defs/outputContractBlock"},
        "loop": {"$ref": "#/$defs/loopBlock"},
        "state": {"$ref": "#/$defs/stateBlock"},
        "context": {"$ref": "#/$defs/contextBlock"},
        "memory": {"$ref": "#/$defs/memoryBlock"},
        "tools": {"$ref": "#/$defs/toolsBlock"},
        "skills": {"$ref": "#/$defs/skillsBlock"},
        "roles": {"$ref": "#/$defs/rolesBlock"},
        "failure": {"$ref": "#/$defs/failureBlock"},
        "observability": {"$ref": "#/$defs/observabilityBlock"},
        "evaluation": {"$ref": "#/$defs/evaluationBlock"},
        "rollout": {"$ref": "#/$defs/rolloutBlock"}
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents", "roles", "tools", "skills", "workflows", "prompts", "evaluations"],
      "properties": {
        "agents": {"type": "array", "items": {"$ref": "#/$defs/agent"}},
        "roles": {"type": "array", "items": {"$ref": "#/$defs/role"}},
        "tools": {"type": "array", "items": {"$ref": "#/$defs/tool"}},
        "skills": {"type": "array", "items": {"$ref": "#/$defs/skill"}},
        "workflows": {"type": "array", "items": {"$ref": "#/$defs/workflow"}},
        "prompts": {"type": "array", "items": {"$ref": "#/$defs/prompt"}},
        "evaluations": {"type": "array", "items": {"$ref": "#/$defs/evaluation"}}
      }
    },
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "slugArray": {"type": "array", "items": {"$ref": "#/$defs/slug"}},
    "nonEmptySlugArray": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slug"}},
    "limitBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turns", "time_seconds", "tool_calls", "tokens", "cost_usd"],
      "properties": {
        "turns": {"type": "number"},
        "time_seconds": {"type": "number"},
        "tool_calls": {"type": "number"},
        "tokens": {"type": "number"},
        "cost_usd": {"type": "number"}
      }
    },
    "objectiveBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "represented_users", "non_goals", "autonomy", "risk", "completion_condition"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "represented_users": {"$ref": "#/$defs/nonEmptyStrings"},
        "non_goals": {"$ref": "#/$defs/nonEmptyStrings"},
        "autonomy": {"type": "string", "minLength": 1},
        "risk": {"type": "string", "minLength": 1},
        "completion_condition": {"type": "string", "minLength": 1}
      }
    },
    "inputContractBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "source_authority", "conflict_policy", "ambiguity_policy", "validation", "injection_boundary"],
      "properties": {
        "accepted": {"$ref": "#/$defs/nonEmptyStrings"},
        "source_authority": {"type": "string", "minLength": 1},
        "conflict_policy": {"type": "string", "minLength": 1},
        "ambiguity_policy": {"type": "string", "minLength": 1},
        "validation": {"type": "string", "minLength": 1},
        "injection_boundary": {"type": "string", "minLength": 1}
      }
    },
    "outputContractBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "primary_owner", "destinations", "completion", "partial_result_policy", "provenance"],
      "properties": {
        "schema": {"type": "string", "minLength": 1},
        "primary_owner": {"$ref": "#/$defs/slug"},
        "destinations": {"$ref": "#/$defs/nonEmptyStrings"},
        "completion": {"type": "string", "minLength": 1},
        "partial_result_policy": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1}
      }
    },
    "loopBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "planning_policy", "observation_policy", "update_policy", "stop_conditions", "budgets"],
      "properties": {
        "pattern": {"type": "string", "minLength": 1},
        "planning_policy": {"type": "string", "minLength": 1},
        "observation_policy": {"type": "string", "minLength": 1},
        "update_policy": {"type": "string", "minLength": 1},
        "stop_conditions": {"$ref": "#/$defs/nonEmptyStrings"},
        "budgets": {"$ref": "#/$defs/limitBudget"}
      }
    },
    "stateBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "states", "transitions", "invariants", "durability", "concurrency", "idempotency", "recovery_checkpoints"],
      "properties": {
        "owner": {"$ref": "#/$defs/slug"},
        "states": {"$ref": "#/$defs/nonEmptyStrings"},
        "transitions": {"$ref": "#/$defs/nonEmptyStrings"},
        "invariants": {"$ref": "#/$defs/nonEmptyStrings"},
        "durability": {"type": "string", "minLength": 1},
        "concurrency": {"type": "string", "minLength": 1},
        "idempotency": {"type": "string", "minLength": 1},
        "recovery_checkpoints": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "contextBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assembly", "selection", "retrieval", "freshness", "compaction", "rehydration", "untrusted_content"],
      "properties": {
        "assembly": {"type": "string", "minLength": 1},
        "selection": {"type": "string", "minLength": 1},
        "retrieval": {"type": "string", "minLength": 1},
        "freshness": {"type": "string", "minLength": 1},
        "compaction": {"type": "string", "minLength": 1},
        "rehydration": {"type": "string", "minLength": 1},
        "untrusted_content": {"type": "string", "minLength": 1}
      }
    },
    "memoryBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["working", "episodic", "durable", "provenance", "retention", "invalidation", "conflict_resolution", "privacy", "write_authority"],
      "properties": {
        "working": {"type": "string", "minLength": 1},
        "episodic": {"type": "string", "minLength": 1},
        "durable": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1},
        "retention": {"type": "string", "minLength": 1},
        "invalidation": {"type": "string", "minLength": 1},
        "conflict_resolution": {"type": "string", "minLength": 1},
        "privacy": {"type": "string", "minLength": 1},
        "write_authority": {"type": "string", "minLength": 1}
      }
    },
    "toolsBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["references", "adapter_contours", "error_policy", "timeout_policy", "retry_policy", "permission_policy"],
      "properties": {
        "references": {"$ref": "#/$defs/slugArray"},
        "adapter_contours": {"$ref": "#/$defs/nonEmptyStrings"},
        "error_policy": {"type": "string", "minLength": 1},
        "timeout_policy": {"type": "string", "minLength": 1},
        "retry_policy": {"type": "string", "minLength": 1},
        "permission_policy": {"type": "string", "minLength": 1}
      }
    },
    "skillsBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["references", "prompt_references", "model_envelope", "activation_policy", "dependency_policy", "prompt_tests"],
      "properties": {
        "references": {"$ref": "#/$defs/slugArray"},
        "prompt_references": {"$ref": "#/$defs/slugArray"},
        "model_envelope": {"type": "string", "minLength": 1},
        "activation_policy": {"type": "string", "minLength": 1},
        "dependency_policy": {"type": "string", "minLength": 1},
        "prompt_tests": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "rolesBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_owner", "contributor_policy", "handoff_schema", "merge_authority", "timeout_policy", "return_policy", "escalation_policy"],
      "properties": {
        "primary_owner": {"$ref": "#/$defs/slug"},
        "contributor_policy": {"type": "string", "minLength": 1},
        "handoff_schema": {"type": "string", "minLength": 1},
        "merge_authority": {"$ref": "#/$defs/slug"},
        "timeout_policy": {"type": "string", "minLength": 1},
        "return_policy": {"type": "string", "minLength": 1},
        "escalation_policy": {"type": "string", "minLength": 1}
      }
    },
    "failureBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taxonomy", "retry_limit", "alternatives", "partial_result_policy", "recovery", "recovery_owner", "escalation", "terminal_stop"],
      "properties": {
        "taxonomy": {"$ref": "#/$defs/nonEmptyStrings"},
        "retry_limit": {"type": "integer", "minimum": 0},
        "alternatives": {"$ref": "#/$defs/nonEmptyStrings"},
        "partial_result_policy": {"type": "string", "minLength": 1},
        "recovery": {"type": "string", "minLength": 1},
        "recovery_owner": {"$ref": "#/$defs/slug"},
        "escalation": {"type": "string", "minLength": 1},
        "terminal_stop": {"type": "string", "minLength": 1}
      }
    },
    "observabilityBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_identity", "version_bindings", "events", "tool_receipts", "usage", "redaction", "alerts"],
      "properties": {
        "trace_identity": {"type": "string", "minLength": 1},
        "version_bindings": {"$ref": "#/$defs/nonEmptyStrings"},
        "events": {"$ref": "#/$defs/nonEmptyStrings"},
        "tool_receipts": {"type": "string", "minLength": 1},
        "usage": {"$ref": "#/$defs/nonEmptyStrings"},
        "redaction": {"type": "string", "minLength": 1},
        "alerts": {"type": "string", "minLength": 1}
      }
    },
    "evaluationBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["references", "mechanical_gates", "outcome_claim", "trajectory_claim", "safety_claim", "regression_policy", "thresholds", "variance_policy", "not_run_policy"],
      "properties": {
        "references": {"$ref": "#/$defs/slugArray"},
        "mechanical_gates": {"$ref": "#/$defs/nonEmptyStrings"},
        "outcome_claim": {"type": "string", "minLength": 1},
        "trajectory_claim": {"type": "string", "minLength": 1},
        "safety_claim": {"type": "string", "minLength": 1},
        "regression_policy": {"type": "string", "minLength": 1},
        "thresholds": {"type": "string", "minLength": 1},
        "variance_policy": {"type": "string", "minLength": 1},
        "not_run_policy": {"type": "string", "minLength": 1}
      }
    },
    "rolloutBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "stages", "feature_gate", "migration", "rollback", "compatibility", "invalidation", "retirement"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "stages": {"$ref": "#/$defs/nonEmptyStrings"},
        "feature_gate": {"type": "string", "minLength": 1},
        "migration": {"type": "string", "minLength": 1},
        "rollback": {"type": "string", "minLength": 1},
        "compatibility": {"type": "string", "minLength": 1},
        "invalidation": {"type": "string", "minLength": 1},
        "retirement": {"type": "string", "minLength": 1}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "outcome", "trigger", "actions", "inputs", "output", "execution_boundary", "tool_families", "context", "side_effects", "permission_risk", "constraints", "success_oracle", "recovery", "evidence_status", "cluster", "primary_owner"],
      "properties": {
        "slug": {"$ref": "#/$defs/slug"},
        "outcome": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "actions": {"$ref": "#/$defs/nonEmptyStrings"},
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "source_locator"], "properties": {"name": {"type": "string", "minLength": 1}, "source_locator": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
        "output": {"type": "string", "minLength": 1},
        "execution_boundary": {"enum": ["deterministic", "model-assisted", "human-authorized"]},
        "tool_families": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "context": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "side_effects": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "permission_risk": {"enum": ["none", "low", "medium", "high", "critical"]},
        "constraints": {"type": "object", "required": ["latency", "ordering", "parallelism"], "properties": {"latency": {"type": "string", "minLength": 1}, "ordering": {"type": "string", "minLength": 1}, "parallelism": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        "success_oracle": {"type": "string", "minLength": 1},
        "recovery": {"type": "string", "minLength": 1},
        "evidence_status": {"enum": ["provided", "observed", "inferred", "assumed", "unresolved"]},
        "cluster": {"$ref": "#/$defs/slug"},
        "primary_owner": {"$ref": "#/$defs/slug"}
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "outcome", "capabilities", "context_authority", "tool_boundary", "permission_boundary", "success_oracle", "recovery_owner"],
      "properties": {
        "slug": {"$ref": "#/$defs/slug"},
        "outcome": {"type": "string", "minLength": 1},
        "capabilities": {"$ref": "#/$defs/nonEmptyStrings"},
        "context_authority": {"$ref": "#/$defs/nonEmptyStrings"},
        "tool_boundary": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "permission_boundary": {"$ref": "#/$defs/nonEmptyStrings"},
        "success_oracle": {"type": "string", "minLength": 1},
        "recovery_owner": {"$ref": "#/$defs/slug"}
      }
    },
    "agent": {
      "type": "object",
      "required": ["slug", "mission", "capabilities", "inputs", "outputs", "tools", "skills", "workflows", "prompts", "state_owner", "done_condition", "autonomy", "limits", "recovery", "trace_events", "evaluations"],
      "properties": {"slug": {"$ref": "#/$defs/slug"}, "mission": {"type": "string", "minLength": 1}, "capabilities": {"$ref": "#/$defs/nonEmptySlugArray"}, "inputs": {"$ref": "#/$defs/nonEmptyStrings"}, "outputs": {"$ref": "#/$defs/nonEmptyStrings"}, "tools": {"$ref": "#/$defs/slugArray"}, "skills": {"$ref": "#/$defs/nonEmptySlugArray"}, "workflows": {"$ref": "#/$defs/nonEmptySlugArray"}, "prompts": {"$ref": "#/$defs/nonEmptySlugArray"}, "state_owner": {"$ref": "#/$defs/slug"}, "done_condition": {"type": "string", "minLength": 1}, "autonomy": {"type": "string", "minLength": 1}, "limits": {"$ref": "#/$defs/limitBudget"}, "recovery": {"type": "string", "minLength": 1}, "trace_events": {"$ref": "#/$defs/nonEmptyStrings"}, "evaluations": {"$ref": "#/$defs/nonEmptySlugArray"}},
      "additionalProperties": false
    },
    "role": {"type": "object", "required": ["slug", "agent", "responsibility", "capabilities", "mutation_scope"], "properties": {"slug": {"$ref": "#/$defs/slug"}, "agent": {"$ref": "#/$defs/slug"}, "responsibility": {"type": "string", "minLength": 1}, "capabilities": {"type": "array", "items": {"$ref": "#/$defs/slug"}}, "mutation_scope": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
    "tool": {"type": "object", "required": ["slug", "purpose", "effect", "input_schema", "output_schema", "permission_rule", "confirmation_rule", "idempotency"], "properties": {"slug": {"$ref": "#/$defs/slug"}, "purpose": {"type": "string", "minLength": 1}, "effect": {"enum": ["read_only", "state_changing", "external_message", "destructive"]}, "input_schema": {"type": "string", "minLength": 1}, "output_schema": {"type": "string", "minLength": 1}, "permission_rule": {"type": "string", "minLength": 1}, "confirmation_rule": {"type": "string", "minLength": 1}, "idempotency": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "skill": {"type": "object", "required": ["slug", "purpose", "capabilities"], "properties": {"slug": {"$ref": "#/$defs/slug"}, "purpose": {"type": "string", "minLength": 1}, "capabilities": {"type": "array", "items": {"$ref": "#/$defs/slug"}}}, "additionalProperties": false},
    "workflow": {"type": "object", "required": ["slug", "purpose", "capabilities", "state_owner"], "properties": {"slug": {"$ref": "#/$defs/slug"}, "purpose": {"type": "string", "minLength": 1}, "capabilities": {"type": "array", "items": {"$ref": "#/$defs/slug"}}, "state_owner": {"$ref": "#/$defs/slug"}}, "additionalProperties": false},
    "prompt": {"type": "object", "required": ["slug", "purpose", "owner", "digest"], "properties": {"slug": {"$ref": "#/$defs/slug"}, "purpose": {"type": "string", "minLength": 1}, "owner": {"$ref": "#/$defs/slug"}, "digest": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "evaluation": {"type": "object", "required": ["slug", "claim", "owner", "oracle", "evidence_state"], "properties": {"slug": {"$ref": "#/$defs/slug"}, "claim": {"type": "string", "minLength": 1}, "owner": {"$ref": "#/$defs/slug"}, "oracle": {"type": "string", "minLength": 1}, "evidence_state": {"enum": ["AUTHORED", "VALIDATED", "EXECUTED", "MECHANICALLY_ELIGIBLE", "JUDGED", "MEASURED_CANDIDATE", "ACCEPTED_TO_STAGING", "PROMOTED", "NOT_RUN", "BLOCKED", "INVALID", "REJECTED", "INCONCLUSIVE"]}}, "additionalProperties": false},
    "dependency": {"type": "object", "required": ["plugin", "version", "skill", "source_digest", "resolved_at", "status"], "properties": {"plugin": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "skill": {"type": "string", "minLength": 1}, "source_digest": {"type": "string", "minLength": 1}, "resolved_at": {"type": "string", "minLength": 1}, "status": {"enum": ["AVAILABLE", "BLOCKED", "INVALID"]}}, "additionalProperties": false},
    "gap": {"type": "object", "required": ["slug", "question", "why_material", "affects", "status"], "properties": {"slug": {"$ref": "#/$defs/slug"}, "question": {"type": "string", "minLength": 1}, "why_material": {"type": "string", "minLength": 1}, "affects": {"type": "array", "items": {"$ref": "#/$defs/slug"}}, "status": {"enum": ["OPEN", "RESOLVED", "BLOCKED"]}}, "additionalProperties": false},
    "decision": {"type": "object", "required": ["slug", "decision", "rationale", "source_locators"], "properties": {"slug": {"$ref": "#/$defs/slug"}, "decision": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}, "source_locators": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false}
  }
}
