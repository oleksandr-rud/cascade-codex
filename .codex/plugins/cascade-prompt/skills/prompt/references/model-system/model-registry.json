{
  "schema_version": 1,
  "checked_at": "2026-08-05",
  "purpose": "Versioned provider-neutral candidate registry. Provider catalog claims establish eligibility only; representative workload evaluation establishes best-observed status.",
  "tier_order": [
    "efficient-structured",
    "balanced-production",
    "frontier-generalist",
    "frontier-autonomous"
  ],
  "tiers": [
    {
      "id": "efficient-structured",
      "operating_envelope": "High-volume or latency-sensitive work with bounded reasoning, explicit schemas, narrow tools, and strong examples or validation.",
      "default_prompt_posture": "Short, explicit, decomposed, schema-first, locally repeated constraints."
    },
    {
      "id": "balanced-production",
      "operating_envelope": "Everyday production work with moderate reasoning, retrieval, tool use, or ambiguity and bounded autonomy.",
      "default_prompt_posture": "Clear objective, scoped context, ordered workflow, tool boundaries, and a bounded repair pass."
    },
    {
      "id": "frontier-generalist",
      "operating_envelope": "Difficult diagnosis, synthesis, coding, research, or multimodal work with high ambiguity or long dependencies.",
      "default_prompt_posture": "Precise outcomes and invariants, adaptive planning, targeted retrieval, and evidence-bound completion."
    },
    {
      "id": "frontier-autonomous",
      "operating_envelope": "Long-horizon agent work with broad tools, recovery, durable state, checkpoints, and consequential actions.",
      "default_prompt_posture": "Explicit authority, state, checkpoints, budgets, recovery, escalation, cleanup, and terminal evidence."
    }
  ],
