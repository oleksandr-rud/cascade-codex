{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/cascade-market-intelligence/evidence-ledger-v4.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_id",
    "version",
    "scope",
    "as_of",
    "status",
    "claims",
    "contradictions",
    "gaps",
    "invalidation_conditions"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "READY",
        "GAP",
        "BLOCKED",
        "INVALID"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "statement",
          "source_id",
          "source_locator",
          "source_sha256",
          "evidence_kind",
          "source_type",
          "entity_id",
          "event_id",
          "observed_at",
          "published_at",
          "retrieved_at",
          "entity_segment",
          "geography",
          "directness",
          "confidence",
          "freshness_status",
          "contradiction_ids",
          "permitted_uses"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "entity_id": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "event_id": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "observed_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "source_type": {
            "enum": [
              "USER_PRIMARY",
              "PUBLIC_PRIMARY",
              "INDEPENDENT",
              "VENDOR_CLAIM",
              "PARTICIPANT_REPORT",
              "INFERENCE",
              "HYPOTHESIS"
            ]
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "entity_segment": {
            "type": "string",
            "minLength": 1
          },
          "geography": {
            "type": "string",
            "minLength": 1
          },
          "directness": {
            "enum": [
              "DIRECT",
              "INDIRECT",
              "INFERRED"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "freshness_status": {
            "enum": [
              "CURRENT",
              "STALE",
              "UNKNOWN"
            ]
          },
          "contradiction_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "permitted_uses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "MARKET_RESEARCH",
                "OPPORTUNITY_SCORING",
                "PMF_ASSESSMENT",
                "EXPERIMENT_DESIGN",
                "PRODUCT_HANDOFF"
              ]
            }
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence_kind": {
            "enum": [
              "OBSERVED_BEHAVIOR",
              "TRANSACTION",
              "RETENTION",
              "INTERVIEW",
              "SURVEY",
              "PUBLIC_FACT",
              "VENDOR_CLAIM",
              "INFERENCE",
              "HYPOTHESIS"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source_type": {
                  "const": "HYPOTHESIS"
                }
              }
            },
            "then": {
              "properties": {
                "evidence_kind": {
                  "const": "HYPOTHESIS"
                },
                "directness": {
                  "const": "INFERRED"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "evidence_kind": {
                  "enum": ["OBSERVED_BEHAVIOR", "TRANSACTION", "RETENTION"]
                }
              },
              "required": ["evidence_kind"]
            },
            "then": {
              "properties": {
                "entity_id": {"type": "string", "minLength": 1},
                "event_id": {"type": "string", "minLength": 1},
                "observed_at": {"type": "string", "format": "date-time"}
              }
            }
          }
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contradiction_id",
          "claim_ids",
          "resolution_status",
          "governing_rule"
        ],
        "properties": {
          "contradiction_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resolution_status": {
            "enum": [
              "RESOLVED",
              "UNRESOLVED"
            ]
          },
          "governing_rule": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "uniqueItems": true
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "invalidation_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "READY"
          }
        }
      },
      "then": {
        "properties": {
          "gaps": {
            "maxItems": 0
          },
          "claims": {
            "contains": {
              "properties": {
                "source_type": {
                  "not": {
                    "enum": [
                      "INFERENCE",
                      "HYPOTHESIS"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
