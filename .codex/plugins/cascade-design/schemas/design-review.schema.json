{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/cascade-design/design-review.schema.json",
  "title": "Cascade Design review or candidate artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "selected_skill",
    "status",
    "subject",
    "sources",
    "scope",
    "coverage",
    "findings",
    "evidence_plan",
    "handoffs",
    "boundaries"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_id": {"type": "string", "pattern": "^DES-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "selected_skill": {
      "enum": ["ux-flow-review", "accessibility-review", "visual-qa", "design-system", "create-design"]
    },
    "status": {
      "description": "Readiness of the review artifact, not a claim that the inspected UI passed. READY may contain planned or non-passing evidence rows; GAP means missing or conflicting foundations prevent a coherent artifact; BLOCKED means a valid defined check cannot run because its environment, tool, or required plugin is unavailable.",
      "enum": ["READY", "GAP", "BLOCKED"]
    },
    "subject": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "scope": {"$ref": "#/$defs/scope"},
    "coverage": {
      "oneOf": [
        {"$ref": "#/$defs/uxCoverage"},
        {"$ref": "#/$defs/accessibilityCoverage"},
        {"$ref": "#/$defs/visualCoverage"},
        {"$ref": "#/$defs/designSystemCoverage"},
        {"$ref": "#/$defs/designCreationCoverage"}
      ]
    },
    "findings": {
      "type": "array",
      "minItems": 0,
      "items": {"$ref": "#/$defs/finding"}
    },
    "evidence_plan": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidencePlan"}
    },
    "handoffs": {
      "type": "array",
      "items": {"$ref": "#/$defs/handoff"}
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_code_changed",
        "legal_compliance_claimed",
        "product_intent_invented",
        "sensitive_data_persisted"
      ],
      "properties": {
        "runtime_code_changed": {"const": false},
        "legal_compliance_claimed": {"const": false},
        "product_intent_invented": {"const": false},
        "sensitive_data_persisted": {"const": false}
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "locator", "authority", "freshness", "status"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9-]{1,31}$"},
        "kind": {
          "enum": [
            "user-request", "product", "persona", "design", "brand", "implementation",
            "screenshot", "browser", "standard", "tool-output", "unknown"
          ]
        },
        "locator": {"type": "string", "minLength": 1},
        "authority": {"enum": ["GOVERNING", "CONTEXT", "OBSERVATION", "MISSING"]},
        "freshness": {"enum": ["CURRENT", "STALE", "UNKNOWN", "NOT_APPLICABLE"]},
        "status": {"enum": ["AVAILABLE", "CONFLICT", "MISSING"]}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "actor", "job", "states", "viewports", "non_goals"],
      "properties": {
        "surface": {"type": ["string", "null"]},
        "actor": {"type": ["string", "null"]},
        "job": {"type": ["string", "null"]},
        "states": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "viewports": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "coverageStatus": {
      "enum": ["PASS", "FAIL", "PLANNED", "GAP", "BLOCKED", "NOT_APPLICABLE"]
    },
    "stateCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "status", "evidence_refs"],
      "properties": {
        "state": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/coverageStatus"},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "uxCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "entry_point", "completion_signal", "interruption_paths",
        "carried_state", "state_coverage", "responsive_behavior"
      ],
      "properties": {
        "kind": {"const": "ux-flow"},
        "entry_point": {"type": ["string", "null"]},
        "completion_signal": {"type": ["string", "null"]},
        "interruption_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "carried_state": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "state_coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stateCoverage"}},
        "responsive_behavior": {"type": "string", "minLength": 1}
      }
    },
    "accessibilityCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "status", "evidence_refs", "notes"],
      "properties": {
        "area": {
          "enum": [
            "semantics", "names-descriptions", "keyboard", "focus", "contrast",
            "target-size", "forms-errors", "status-messages", "reduced-motion", "mobile"
          ]
        },
        "status": {"$ref": "#/$defs/coverageStatus"},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "accessibilityCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "standards", "checks", "non_attestation_note"],
      "properties": {
        "kind": {"const": "accessibility"},
        "standards": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "checks": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/accessibilityCheck"}},
        "non_attestation_note": {"type": "string", "minLength": 20}
      }
    },
    "visualMatrixRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewport", "state", "status", "evidence_refs", "notes"],
      "properties": {
        "viewport": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/coverageStatus"},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "visualCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expected_source_id", "matrix", "checks", "residual_risk"],
      "properties": {
        "kind": {"const": "visual"},
        "expected_source_id": {"type": ["string", "null"]},
        "matrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/visualMatrixRow"}},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "overlap-clipping", "horizontal-overflow", "hierarchy-density", "primary-action",
              "product-flow-fit", "brand-content-fit", "token-component-consistency",
              "interaction-states", "mobile-usability", "functional-distinction"
            ]
          }
        },
        "residual_risk": {"type": "string", "minLength": 1}
      }
    },
    "designCreationCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_of_truth_ids",
        "required_views",
        "frames",
        "interaction_rules",
        "responsive_rules",
        "assets_and_tokens",
        "unresolved_gaps"
      ],
      "properties": {
        "kind": {
          "const": "design-creation"
        },
        "source_of_truth_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "frame_id",
              "editable_locator",
              "preview_locator",
              "revision",
              "viewport",
              "state",
              "capture_conditions",
              "inspection"
            ],
            "properties": {
              "frame_id": {
                "type": "string",
                "minLength": 1
              },
              "editable_locator": {
                "type": "string",
                "minLength": 1
              },
              "preview_locator": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "viewport": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "minLength": 1
              },
              "capture_conditions": {
                "type": "string",
                "minLength": 1
              },
              "inspection": {
                "enum": [
                  "PASS",
                  "GAP",
                  "BLOCKED"
                ]
              }
            }
          }
        },
        "interaction_rules": {
          "type": "string",
          "minLength": 1
        },
        "responsive_rules": {
          "type": "string",
          "minLength": 1
        },
        "assets_and_tokens": {
          "type": "string",
          "minLength": 1
        },
        "unresolved_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_views": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "viewport",
              "state"
            ],
            "properties": {
              "viewport": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "designSystemCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "rule_type", "reuse_evidence", "source_of_truth_ids", "observable_rule",
        "user_visible_effect", "states", "responsive_constraints", "accessibility_constraints",
        "evidence_requirements", "migration_and_invalidation"
      ],
      "properties": {
        "kind": {"const": "design-system"},
        "rule_type": {
          "enum": ["token", "component", "interaction", "responsive", "accessibility", "motion", "content", "visual-evidence", "gap"]
        },
        "reuse_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_of_truth_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "observable_rule": {"type": "string", "minLength": 1},
        "user_visible_effect": {"type": "string", "minLength": 1},
        "states": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "responsive_constraints": {"type": "string", "minLength": 1},
        "accessibility_constraints": {"type": "string", "minLength": 1},
        "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "migration_and_invalidation": {"type": "string", "minLength": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "severity", "classification", "summary", "evidence_refs", "recommendation", "owner_route"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^F-[A-Z0-9][A-Z0-9-]{1,31}$"},
        "severity": {"enum": ["P0", "P1", "P2", "P3"]},
        "classification": {"enum": ["confirmed", "risk", "manual-test", "gap"]},
        "summary": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "recommendation": {"type": "string", "minLength": 1},
        "owner_route": {"type": "string", "minLength": 1}
      }
    },
    "evidencePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "check", "mode", "status", "expected_evidence"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^EV-[A-Z0-9][A-Z0-9-]{1,31}$"},
        "check": {"type": "string", "minLength": 1},
        "mode": {"enum": ["source-review", "manual", "browser", "automated", "functional", "semantic-eval"]},
        "status": {"$ref": "#/$defs/coverageStatus"},
        "expected_evidence": {"type": "string", "minLength": 1}
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "reason", "status", "required_input", "expected_output"],
      "properties": {
        "route": {
          "type": "string",
          "pattern": "^(cascade-[a-z0-9-]+:[a-z0-9-]+|host:[a-z0-9-]+|qualified-review|stop)$"
        },
        "reason": {"type": "string", "minLength": 1},
        "status": {"enum": ["REQUIRED", "OPTIONAL", "NOT_APPLICABLE", "BLOCKED"]},
        "required_input": {"type": "string", "minLength": 1},
        "expected_output": {"type": "string", "minLength": 1}
      }
    }
  }
}
