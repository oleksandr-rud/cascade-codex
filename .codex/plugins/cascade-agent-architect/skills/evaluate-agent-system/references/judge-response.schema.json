{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/cascade-agent-architect/judge-response.schema.json",
  "title": "Independent architecture judge response",
  "description": "Canonical reducer input. A schema-valid response is COMPLETE. Preserve ratings as an evidence-bearing array; reducers must require the profile's five unique dimension IDs, map dimension_id to rating without relying on array order, use judge_id as identity, and retain evidence and rationale as audit sidecars.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "profile_version", "case_id", "run_id", "judge_id", "ratings", "verdict", "uncertainty", "leakage_check"],
  "properties": {
    "profile_id": {"enum": ["architecture-outcome", "architecture-trajectory"]},
    "profile_version": {"const": "1.0.0"},
    "case_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "judge_id": {"type": "string", "minLength": 1},
    "ratings": {
      "type": "array",
      "description": "Canonical evidence-bearing ratings. Exactly one row per dimension; array order is non-semantic.",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension_id", "rating", "evidence", "rationale"],
        "properties": {
          "dimension_id": {"type": "string", "minLength": 1},
          "rating": {"type": "integer", "minimum": 0, "maximum": 4},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "verdict": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
    "uncertainty": {"type": "string", "minLength": 1},
    "leakage_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blind", "blind_to_expected", "blind_to_peer", "excluded_inputs_seen"],
      "properties": {
        "blind": {"const": true},
        "blind_to_expected": {"const": true},
        "blind_to_peer": {"const": true},
        "excluded_inputs_seen": {"type": "array", "maxItems": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"profile_id": {"const": "architecture-outcome"}}},
      "then": {
        "properties": {
          "ratings": {
            "items": {
              "properties": {
                "dimension_id": {"enum": ["task-fit", "capability-coverage", "behavioral-completeness", "safety-operability", "minimality-actionability"]}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"profile_id": {"const": "architecture-trajectory"}}},
      "then": {
        "properties": {
          "ratings": {
            "items": {
              "properties": {
                "dimension_id": {"enum": ["source-selection-grounding", "source-capability-derivation", "cluster-boundary-quality", "building-block-topology", "adaptation-efficiency"]}
              }
            }
          }
        }
      }
    }
  ]
}
