{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/cascade-agent-architect/design-simulation-persona.schema.json",
  "title": "Cascade Agent Architect design simulation persona profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "purpose", "sources", "claims", "stable", "dynamic", "boundaries", "limitations"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$" },
    "kind": { "enum": ["evidence-backed", "user-provided", "synthetic-hypothesis"] },
    "purpose": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "locator", "authority", "revision", "content_digest"],
        "properties": {
          "id": { "$ref": "#/$defs/name" },
          "locator": { "type": "string", "minLength": 1 },
          "authority": { "enum": ["interview", "self-report", "observed-behavior", "research-record", "user-provided", "hypothesis"] },
          "revision": { "type": "string", "minLength": 1 },
          "content_digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "class", "source_refs", "confidence"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "class": { "enum": ["self-report", "observed-behavior", "measured-trait", "role-context", "goal", "knowledge", "constraint", "preference", "inference", "synthetic-assumption"] },
          "source_refs": { "$ref": "#/$defs/nonEmptyNames" },
          "confidence": { "enum": ["low", "medium", "high"] }
        }
      }
    },
    "stable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_context", "goals", "knowledge", "constraints", "communication", "traits"],
      "properties": {
        "role_context": { "$ref": "#/$defs/nonEmptyStrings" },
        "goals": { "$ref": "#/$defs/nonEmptyStrings" },
        "knowledge": { "$ref": "#/$defs/strings" },
        "constraints": { "$ref": "#/$defs/strings" },
        "communication": { "type": "string", "minLength": 1 },
        "traits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value", "basis", "source_refs", "behavioral_implication"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 },
              "basis": { "enum": ["measured", "self-reported", "observed", "inferred", "synthetic-hypothesis"] },
              "source_refs": { "$ref": "#/$defs/nonEmptyNames" },
              "behavioral_implication": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "dynamic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variables", "transitions"],
      "properties": {
        "variables": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "initial", "allowed_values", "meaning"],
            "properties": {
              "name": { "$ref": "#/$defs/name" },
              "initial": { "type": "string", "minLength": 1 },
              "allowed_values": { "type": "array", "minItems": 2, "maxItems": 7, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "meaning": { "type": "string", "minLength": 1 }
            }
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when", "set", "behavioral_effect"],
            "properties": {
              "when": { "type": "string", "minLength": 1 },
              "set": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
              "behavioral_effect": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prohibited_inferences", "sensitive_data"],
      "properties": {
        "prohibited_inferences": { "$ref": "#/$defs/nonEmptyStrings" },
        "sensitive_data": { "enum": ["minimized", "explicitly-authorized"] }
      }
    },
    "limitations": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nonEmptyNames": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/name" } }
  }
}
