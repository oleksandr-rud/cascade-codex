{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/cascade-product/product-decision-v4.schema.json",
  "title": "Cascade product decision and gate record v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "version",
    "decision_owner",
    "disposition",
    "approval_status",
    "current_state",
    "proposed_state",
    "gate_status",
    "evidence",
    "unmet_conditions",
    "work_product",
    "confidence",
    "recommendation",
    "rationale",
    "alternatives",
    "transition_authority",
    "invalidation_conditions",
    "next_gate"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "decision_owner": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "disposition": {
      "enum": [
        "ADVANCE",
        "HOLD",
        "STOP",
        "DEFER",
        "NARROW",
        "RESEARCH",
        "REJECT"
      ]
    },
    "approval_status": {
      "enum": [
        "PROPOSED",
        "PENDING_APPROVAL",
        "APPROVED",
        "REJECTED",
        "DEFERRED"
      ]
    },
    "current_state": {
      "enum": [
        "INTAKE",
        "DISCOVERY",
        "DEFINITION",
        "VALIDATION",
        "DELIVERY_READY",
        "LEARNING"
      ]
    },
    "proposed_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "INTAKE",
        "DISCOVERY",
        "DEFINITION",
        "VALIDATION",
        "DELIVERY_READY",
        "LEARNING",
        null
      ]
    },
    "gate_status": {
      "enum": [
        "READY",
        "GAP",
        "BLOCKED",
        "INVALID"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "version",
          "sha256",
          "evidence_class",
          "acceptance_status",
          "accepted_by",
          "scope",
          "as_of"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence_class": {
            "enum": [
              "OBSERVED",
              "USER_PROVIDED",
              "ACCEPTED_DECISION",
              "INFERRED",
              "HYPOTHESIS",
              "SYNTHETIC",
              "SIMULATION",
              "MECHANICAL",
              "SEMANTIC",
              "IMPLEMENTATION",
              "DEPLOYMENT",
              "RELEASE"
            ]
          },
          "acceptance_status": {
            "enum": [
              "CANDIDATE",
              "ACCEPTED",
              "REJECTED",
              "CONFLICT"
            ]
          },
          "accepted_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "acceptance_status": {
                  "const": "ACCEPTED"
                }
              }
            },
            "then": {
              "properties": {
                "accepted_by": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "uniqueItems": true
    },
    "unmet_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "work_product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "version",
        "status",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "READY",
            "GAP",
            "BLOCKED",
            "INVALID",
            "NOT_RUN",
            "ABSTAIN",
            "PROPOSED",
            "PENDING_APPROVAL",
            "APPROVED",
            "REJECTED",
            "DEFERRED"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "basis",
        "limitations"
      ],
      "properties": {
        "level": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "transition_authority": {
      "type": [
        "string",
        "null"
      ]
    },
    "invalidation_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "next_gate": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "INTAKE",
        "DISCOVERY",
        "DEFINITION",
        "VALIDATION",
        "DELIVERY_READY",
        "LEARNING",
        null
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "approval_status": {
            "const": "APPROVED"
          }
        }
      },
      "then": {
        "properties": {
          "decision_owner": {
            "type": "string",
            "minLength": 1
          },
          "transition_authority": {
            "type": "string",
            "minLength": 1
          },
          "gate_status": {
            "const": "READY"
          },
          "unmet_conditions": {
            "maxItems": 0
          },
          "proposed_state": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval_status": {
            "enum": [
              "PROPOSED",
              "PENDING_APPROVAL"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "transition_authority": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate_status": {
            "const": "READY"
          }
        }
      },
      "then": {
        "properties": {
          "unmet_conditions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate_status": {
            "enum": [
              "GAP",
              "BLOCKED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "unmet_conditions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval_status": {
            "enum": [
              "REJECTED",
              "DEFERRED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "proposed_state": {
            "type": "null"
          },
          "transition_authority": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "enum": [
              "STOP",
              "DEFER",
              "REJECT"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "proposed_state": {
            "type": "null"
          },
          "next_gate": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "ADVANCE"
          }
        }
      },
      "then": {
        "properties": {
          "proposed_state": {
            "type": "string"
          },
          "next_gate": {
            "type": "string"
          }
        }
      }
    }
  ]
}
