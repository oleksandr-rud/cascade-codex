{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/workflows/selection-intake.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "status", "envelope", "task_envelope_id", "request_digest", "capability_catalog_digest", "input_bindings", "input_artifacts", "model_policy", "instruction_sha256", "prompt", "prompt_sha256", "intake_digest", "dispatch_authorized"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "cascade-capability-intake"},
    "status": {"const": "REQUIRES_INTERPRETATION"},
    "envelope": {"type": "object"},
    "task_envelope_id": {"type": "string", "pattern": "^TE-[a-f0-9]{16}$"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "capability_catalog_digest": {"$ref": "#/$defs/digest"},
    "input_bindings": {"type": "array", "maxItems": 64, "items": {"type": "object"}},
    "input_artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "model_policy": {
      "type": "object", "additionalProperties": false, "required": ["model", "reasoning_effort"],
      "properties": {"model": {"type": "string", "minLength": 1}, "reasoning_effort": {"enum": ["high", "max"]}}
    },
    "instruction_sha256": {"$ref": "#/$defs/digest"},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 200000},
    "prompt_sha256": {"$ref": "#/$defs/digest"},
    "intake_digest": {"$ref": "#/$defs/digest"},
    "dispatch_authorized": {"const": false}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
