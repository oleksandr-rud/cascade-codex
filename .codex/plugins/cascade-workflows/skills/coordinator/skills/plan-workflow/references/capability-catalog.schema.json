{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/cascade-coordinator/plugin-capability-catalog.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "marketplace",
    "plugins",
    "catalog_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_type": {
      "const": "cascade-plugin-capability-catalog"
    },
    "marketplace": {
      "const": ".agents/plugins/marketplace.json"
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "manifest_path",
          "descriptor_path",
          "manifest_sha256",
          "descriptor_sha256",
          "model_policy",
          "skills"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/slug"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "manifest_path": {
            "type": "string",
            "pattern": "^\\.codex/plugins/[a-z0-9-]+/\\.codex-plugin/plugin\\.json$"
          },
          "descriptor_path": {
            "type": "string",
            "pattern": "^\\.codex/plugins/[a-z0-9-]+/capabilities\\.yaml$"
          },
          "manifest_sha256": {
            "$ref": "#/$defs/digest"
          },
          "descriptor_sha256": {
            "$ref": "#/$defs/digest"
          },
          "model_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model",
              "planning_reasoning_effort",
              "evaluation_reasoning_effort"
            ],
            "properties": {
              "model": {
                "enum": [
                  "gpt-5.6-sol",
                  "gpt-6-sol",
                  "gpt-6-astra"
                ]
              },
              "planning_reasoning_effort": {
                "enum": [
                  "high",
                  "max"
                ]
              },
              "evaluation_reasoning_effort": {
                "enum": [
                  "high",
                  "max"
                ]
              }
            }
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "activation": {
            "$ref": "#/$defs/pluginActivation"
          }
        }
      }
    },
    "catalog_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pluginActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "triggers",
        "anti_triggers",
        "depths",
        "topics"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 20
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "anti_triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "depths": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description",
              "evidence",
              "completion",
              "escalates_when"
            ],
            "properties": {
              "id": {
                "enum": [
                  "LIGHTWEIGHT",
                  "FOCUSED",
                  "STRUCTURAL"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 20
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "completion": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "escalates_when": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 3
                }
              }
            }
          }
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description",
              "routes"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/slug"
              },
              "description": {
                "type": "string",
                "minLength": 20
              },
              "routes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              }
            }
          }
        }
      }
    }
  }
}
