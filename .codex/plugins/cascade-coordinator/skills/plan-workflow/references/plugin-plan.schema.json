{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/cascade-coordinator/plugin-plan.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "status",
    "task_envelope_id",
    "request_digest",
    "capability_catalog_digest",
    "capability_selection_digest",
    "planner",
    "input_artifacts",
    "selected_nodes",
    "edges",
    "parallel_groups",
    "rejected_candidates",
    "validation_gates",
    "stop_conditions",
    "blockers",
    "dispatch_authorized"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "const": "cascade-plugin-plan" },
    "status": { "enum": ["CANDIDATE", "BLOCKED"] },
    "task_envelope_id": { "type": "string", "pattern": "^TE-[a-f0-9]{16}$" },
    "request_digest": { "$ref": "#/$defs/digest" },
    "capability_catalog_digest": { "$ref": "#/$defs/digest" },
    "capability_selection_digest": { "$ref": "#/$defs/digest" },
    "planner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "model", "reasoning_effort", "prompt_sha256"],
      "properties": {
        "route": { "const": "cascade-coordinator:plan-workflow" },
        "model": { "const": "gpt-5.6-sol" },
        "reasoning_effort": { "enum": ["high", "max"] },
        "prompt_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "input_artifacts": { "$ref": "#/$defs/slugList" },
    "selected_nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "artifact"],
        "properties": {
          "from": { "$ref": "#/$defs/nodeId" },
          "to": { "$ref": "#/$defs/nodeId" },
          "artifact": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "parallel_groups": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/nodeId" }
      }
    },
    "rejected_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route", "reason"],
        "properties": {
          "route": { "$ref": "#/$defs/route" },
          "reason": { "type": "string", "minLength": 3 }
        }
      }
    },
    "validation_gates": { "$ref": "#/$defs/nonEmptyTextList" },
    "stop_conditions": { "$ref": "#/$defs/nonEmptyTextList" },
    "blockers": { "$ref": "#/$defs/textList" },
    "dispatch_authorized": { "const": false }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "slugList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "textList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "nonEmptyTextList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "route": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "nodeId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "route",
        "plugin_version",
        "claim_ids",
        "policy_tags",
        "consumes",
        "produces",
        "effect",
        "authority",
        "model",
        "reason"
      ],
      "properties": {
        "node_id": { "$ref": "#/$defs/nodeId" },
        "route": { "$ref": "#/$defs/route" },
        "plugin_version": { "type": "string", "minLength": 1 },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^CL-[0-9]{3}$" }
        },
        "policy_tags": { "$ref": "#/$defs/slugList" },
        "consumes": { "$ref": "#/$defs/slugList" },
        "optional_consumes": { "$ref": "#/$defs/slugList" },
        "produces": { "$ref": "#/$defs/slugList" },
        "effect": { "enum": ["READ_ONLY", "CANDIDATE_WRITE", "HOST_EFFECT"] },
        "authority": { "enum": ["READ_ONLY", "LOCAL_WRITE", "EXTERNAL_WRITE", "PRIVILEGED", "DESTRUCTIVE"] },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "reasoning_effort"],
          "properties": {
            "id": { "const": "gpt-5.6-sol" },
            "reasoning_effort": { "enum": ["high", "max"] }
          }
        },
        "reason": { "type": "string", "minLength": 3 }
      }
    }
  }
}
