{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/cascade-coordinator/plugin-capabilities.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugin", "model_policy", "skills"],
  "properties": {
    "schema_version": { "const": 1 },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "#/$defs/slug" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "model_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "planning_reasoning_effort", "evaluation_reasoning_effort"],
      "properties": {
        "model": { "const": "gpt-5.6-sol" },
        "planning_reasoning_effort": { "enum": ["high", "max"] },
        "evaluation_reasoning_effort": { "const": "max" }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "route": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "slugList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "routeList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/route" }
    },
    "textList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "description",
        "triggers",
        "anti_triggers",
        "consumes",
        "produces",
        "required_dependencies",
        "optional_dependencies",
        "policy_tags",
        "effect",
        "authority",
        "evaluation_cases"
      ],
      "properties": {
        "route": { "$ref": "#/$defs/route" },
        "description": { "type": "string", "minLength": 20 },
        "triggers": { "$ref": "#/$defs/textList" },
        "anti_triggers": { "$ref": "#/$defs/textList" },
        "consumes": { "$ref": "#/$defs/slugList" },
        "produces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "required_dependencies": { "$ref": "#/$defs/routeList" },
        "optional_dependencies": { "$ref": "#/$defs/routeList" },
        "policy_tags": { "$ref": "#/$defs/slugList" },
        "effect": { "enum": ["READ_ONLY", "CANDIDATE_WRITE", "HOST_EFFECT"] },
        "authority": { "enum": ["READ_ONLY", "LOCAL_WRITE", "EXTERNAL_WRITE", "PRIVILEGED", "DESTRUCTIVE"] },
        "evaluation_cases": { "$ref": "#/$defs/slugList" }
      }
    }
  }
}
