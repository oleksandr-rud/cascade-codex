{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/cascade-coordinator/capability-selection.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "status",
    "task_envelope_id",
    "request_digest",
    "capability_catalog_digest",
    "selection_digest",
    "selector",
    "input_artifacts",
    "selected_candidates",
    "rejected_candidates",
    "ambiguities",
    "blockers",
    "dispatch_authorized"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "const": "cascade-capability-selection" },
    "status": { "enum": ["CANDIDATE", "BLOCKED"] },
    "task_envelope_id": { "type": "string", "pattern": "^TE-[a-f0-9]{16}$" },
    "request_digest": { "$ref": "#/$defs/digest" },
    "capability_catalog_digest": { "$ref": "#/$defs/digest" },
    "selection_digest": { "$ref": "#/$defs/digest" },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "model", "reasoning_effort", "prompt_sha256"],
      "properties": {
        "route": { "const": "cascade-coordinator:select-capabilities" },
        "model": { "const": "gpt-6-astra" },
        "reasoning_effort": { "enum": ["high", "max"] },
        "prompt_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "input_artifacts": { "$ref": "#/$defs/slugList" },
    "selected_candidates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "rejected_candidates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/rejection" }
    },
    "ambiguities": { "$ref": "#/$defs/textList" },
    "blockers": { "$ref": "#/$defs/textList" },
    "dispatch_authorized": { "const": false }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "route": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "slugList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "routeList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/route" }
    },
    "textList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "nonEmptyTextList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "plugin_version",
        "claim_ids",
        "trigger_evidence",
        "anti_trigger_disposition",
        "required_dependencies",
        "effect",
        "authority",
        "reason"
      ],
      "properties": {
        "route": { "$ref": "#/$defs/route" },
        "plugin_version": { "type": "string", "minLength": 1 },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^CL-[0-9]{3}$" }
        },
        "trigger_evidence": { "$ref": "#/$defs/nonEmptyTextList" },
        "anti_trigger_disposition": { "type": "string", "minLength": 3 },
        "required_dependencies": { "$ref": "#/$defs/routeList" },
        "effect": { "enum": ["READ_ONLY", "CANDIDATE_WRITE", "HOST_EFFECT"] },
        "authority": { "enum": ["READ_ONLY", "LOCAL_WRITE", "EXTERNAL_WRITE", "PRIVILEGED", "DESTRUCTIVE"] },
        "reason": { "type": "string", "minLength": 3 }
      }
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "reason"],
      "properties": {
        "route": { "$ref": "#/$defs/route" },
        "reason": { "type": "string", "minLength": 3 }
      }
    }
  }
}
