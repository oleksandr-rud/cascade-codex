{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/growth-strategy.schema.json",
  "title": "Cascade growth strategy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "strategy_id",
    "version",
    "status",
    "decision",
    "scope",
    "source_bindings",
    "channels",
    "stages",
    "economics",
    "product_feedback",
    "next_test",
    "learning",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "kind": {
      "const": "GROWTH_STRATEGY"
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "READY",
        "GAP",
        "BLOCKED"
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "rationale",
        "unknowns"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "TEST",
            "RESEARCH",
            "REVISE",
            "HOLD",
            "SCALE",
            "STOP"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment",
        "job",
        "outcome",
        "cadence",
        "business_objective",
        "product_version"
      ],
      "properties": {
        "segment": {
          "type": "string",
          "minLength": 1
        },
        "job": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "cadence": {
          "type": "string",
          "enum": [
            "FINITE",
            "EPISODIC",
            "RECURRING",
            "CAPABILITY",
            "UNKNOWN"
          ]
        },
        "business_objective": {
          "type": "string",
          "minLength": 1
        },
        "product_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "source_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "sha256",
          "evidence_class",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence_class": {
            "type": "string",
            "enum": [
              "OBSERVATION",
              "PAYMENT",
              "RETENTION",
              "RESEARCH",
              "HYPOTHESIS",
              "INFERENCE"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "CURRENT",
              "STALE"
            ]
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "motion",
          "reach_hypothesis",
          "constraints",
          "evidence_ids"
        ],
        "properties": {
          "channel_id": {
            "type": "string",
            "minLength": 1
          },
          "motion": {
            "type": "string",
            "minLength": 1
          },
          "reach_hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "mechanism",
          "metric",
          "denominator",
          "status",
          "evidence_ids"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "ATTENTION",
              "QUALIFIED_ACTION",
              "ACTIVATION",
              "OUTCOME",
              "PAYMENT",
              "RETURN",
              "REFERRAL",
              "EXPANSION",
              "COMPLETION"
            ]
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "denominator": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "HYPOTHESIS",
              "OBSERVED"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "unit",
        "window",
        "cost_basis",
        "net_contribution",
        "marginal_acquisition_cost",
        "assumptions",
        "concentration",
        "evidence_ids"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "ESTIMATED",
            "OBSERVED"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "window": {
          "type": "string",
          "minLength": 1
        },
        "cost_basis": {
          "type": "string",
          "minLength": 1
        },
        "net_contribution": {
          "type": [
            "number",
            "null"
          ]
        },
        "marginal_acquisition_cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "concentration": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "product_feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feedback_id",
          "changed_hypothesis",
          "requirement_id",
          "reason",
          "evidence_ids",
          "owner",
          "next_action"
        ],
        "properties": {
          "feedback_id": {
            "type": "string",
            "minLength": 1
          },
          "changed_hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "requirement_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "owner": {
            "type": "string",
            "enum": [
              "cascade-product:define-product",
              "cascade-product:manage-product-lifecycle",
              "cascade-product:validate-product",
              "cascade-market:brand-positioning"
            ]
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "next_test": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hypothesis",
            "unit",
            "baseline",
            "success",
            "guardrails",
            "failure",
            "inconclusive",
            "owner",
            "time_limit",
            "budget_limit",
            "status"
          ],
          "properties": {
            "hypothesis": {
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "baseline": {
              "type": "string",
              "minLength": 1
            },
            "success": {
              "type": "string",
              "minLength": 1
            },
            "guardrails": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "failure": {
              "type": "string",
              "minLength": 1
            },
            "inconclusive": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "time_limit": {
              "type": "string",
              "minLength": 1
            },
            "budget_limit": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "const": "PROPOSED"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reopen_decision",
        "review_trigger",
        "evidence_limitations"
      ],
      "properties": {
        "reopen_decision": {
          "type": "string",
          "minLength": 1
        },
        "review_trigger": {
          "type": "string",
          "minLength": 1
        },
        "evidence_limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication",
        "spend",
        "implementation"
      ],
      "properties": {
        "publication": {
          "const": "NOT_RUN"
        },
        "spend": {
          "const": "NOT_RUN"
        },
        "implementation": {
          "const": "NOT_RUN"
        }
      }
    }
  }
}
