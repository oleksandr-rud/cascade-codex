{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/cascade-evals/judge-packet.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "subject",
    "profile",
    "target_packet",
    "target_output",
    "blindness",
    "response_schema"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evaluation_id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "version", "role", "decision", "population", "model", "dimensions", "blindness"],
      "properties": {
        "profile_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "version": {"type": "integer", "minimum": 1},
        "role": {"enum": ["outcome", "trajectory", "safety", "claim-support", "other"]},
        "decision": {"type": "string", "minLength": 1},
        "population": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/dimension"}
        },
        "blindness": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "target_packet": {"$ref": "#/$defs/artifact"},
    "target_output": {"$ref": "#/$defs/artifact"},
    "blindness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excluded_fields", "leakage_check", "sealed_state_during_judging"],
      "properties": {
        "excluded_fields": {
          "type": "array",
          "const": [
            "expected_status",
            "oracle",
            "mechanical_assertions",
            "threshold",
            "minimum_dimension",
            "peer_judgments",
            "builder_context"
          ]
        },
        "leakage_check": {"const": "PASS"},
        "sealed_state_during_judging": {"const": "HELD_IN_CONTROLLER_MEMORY"}
      }
    },
    "response_schema": {"const": "cascade-evals:judge-response-v1"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension_id", "description", "weight", "anchors"],
      "properties": {
        "dimension_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "description": {"type": "string", "minLength": 1},
        "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "anchors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["0", "1", "2", "3", "4"],
          "properties": {
            "0": {"type": "string", "minLength": 1},
            "1": {"type": "string", "minLength": 1},
            "2": {"type": "string", "minLength": 1},
            "3": {"type": "string", "minLength": 1},
            "4": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
