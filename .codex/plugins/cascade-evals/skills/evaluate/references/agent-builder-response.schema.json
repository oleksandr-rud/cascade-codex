{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/cascade-evals/agent-builder-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "subject_digest",
    "status",
    "findings",
    "sealed_material_handled_as_data"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "evaluation_id": {"type": "string", "minLength": 1},
    "subject_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"type": "string", "enum": ["READY", "INVALID"]},
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "scope", "finding"],
        "properties": {
          "severity": {"type": "string", "enum": ["PASS", "WARN", "FAIL"]},
          "scope": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1}
        }
      }
    },
    "sealed_material_handled_as_data": {"type": "boolean", "const": true}
  }
}
