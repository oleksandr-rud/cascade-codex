{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/cascade-evals/judge-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "version", "role", "decision", "population", "model", "threshold", "minimum_dimension", "dimensions", "blindness"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "integer", "minimum": 1},
    "role": {"enum": ["outcome", "trajectory", "safety", "claim-support", "other"]},
    "decision": {"type": "string", "minLength": 1},
    "population": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "minimum_dimension": {"type": "integer", "minimum": 0, "maximum": 4},
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension_id", "description", "weight", "anchors"],
        "properties": {
          "dimension_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "description": {"type": "string", "minLength": 1},
          "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "anchors": {
            "type": "object",
            "additionalProperties": false,
            "required": ["0", "1", "2", "3", "4"],
            "properties": {
              "0": {"type": "string", "minLength": 1},
              "1": {"type": "string", "minLength": 1},
              "2": {"type": "string", "minLength": 1},
              "3": {"type": "string", "minLength": 1},
              "4": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "blindness": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
