{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/cascade-evals/evaluation-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "subject", "models", "mechanical_status", "evidence_root", "evidence", "required_profile_ids", "judgments"],
  "properties": {
    "schema_version": {"const": 1},
    "evaluation_id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "digest"],
      "properties": {
        "kind": {"enum": ["prompt", "agent", "simulation", "harness", "other"]},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builder_model",
        "builder_reasoning_effort",
        "target_model",
        "target_reasoning_effort",
        "judge_model",
        "judge_reasoning_effort"
      ],
      "properties": {
        "builder_model": {"type": "string", "minLength": 1},
        "builder_reasoning_effort": {"$ref": "#/$defs/reasoning_effort"},
        "target_model": {"type": "string", "minLength": 1},
        "target_reasoning_effort": {"$ref": "#/$defs/reasoning_effort"},
        "judge_model": {"type": "string", "minLength": 1},
        "judge_reasoning_effort": {"$ref": "#/$defs/reasoning_effort"},
        "explicit_comparison": {"type": "boolean"}
      }
    },
    "mechanical_status": {"enum": ["PASS", "NOT_RUN", "BLOCKED", "INVALID"]},
    "evidence_root": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "required_profile_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "response"],
        "properties": {
          "profile": {"$ref": "../../build-judge/references/judge-profile.schema.json"},
          "response": {"$ref": "../../build-judge/references/judge-response.schema.json"}
        }
      }
    }
  },
  "$defs": {
    "reasoning_effort": {
      "enum": ["low", "medium", "high", "xhigh", "max", "ultra"]
    }
  }
}
