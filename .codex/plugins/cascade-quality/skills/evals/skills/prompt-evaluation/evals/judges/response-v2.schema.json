{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/prompt-quality-judge-response-v2.json",
  "title": "Blind ratings-only prompt judge response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "rubric_version",
    "run_id",
    "ratings",
    "verdict",
    "missing_evidence"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "rubric_version": {
      "const": 2
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "ratings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension_id",
          "rating",
          "rationale",
          "evidence"
        ],
        "properties": {
          "dimension_id": {
            "type": "string",
            "minLength": 1
          },
          "rating": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "RATED",
        "BLOCKED"
      ]
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "oneOf": [
    {
      "required": [
        "task_id"
      ],
      "not": {
        "required": [
          "fixture_id"
        ]
      }
    },
    {
      "required": [
        "fixture_id"
      ],
      "not": {
        "required": [
          "task_id"
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "BLOCKED"
          }
        }
      },
      "then": {
        "properties": {
          "ratings": {
            "maxItems": 0
          },
          "missing_evidence": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "ratings": {
            "minItems": 1
          },
          "missing_evidence": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
