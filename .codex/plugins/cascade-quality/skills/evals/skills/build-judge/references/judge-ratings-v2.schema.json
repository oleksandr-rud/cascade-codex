{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/cascade-evals/judge-ratings-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ratings", "leakage_check"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "ratings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dimension_id", "rating", "evidence", "rationale"],
        "properties": {
          "dimension_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "rating": {"type": "integer", "minimum": 0, "maximum": 4},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "leakage_check": {"type": "string", "enum": ["PASS", "FAIL"]}
  }
}
