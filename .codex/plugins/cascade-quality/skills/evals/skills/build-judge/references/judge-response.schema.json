{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/cascade-evals/judge-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "subject_digest", "profile_id", "profile_version", "judge_identity", "judge_context_id", "ratings", "verdict", "leakage_check"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "evaluation_id": {"type": "string", "minLength": 1},
    "subject_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "profile_version": {"type": "integer", "minimum": 1},
    "judge_identity": {"type": "string", "minLength": 1},
    "judge_context_id": {"type": "string", "minLength": 1},
    "ratings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension_id", "rating", "evidence", "rationale"],
        "properties": {
          "dimension_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "rating": {"type": "integer", "minimum": 0, "maximum": 4},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "verdict": {"type": "string", "enum": ["PASS", "FAIL"]},
    "leakage_check": {"type": "string", "enum": ["PASS", "FAIL"]}
  }
}
