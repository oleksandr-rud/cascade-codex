{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/qa-artifact.schema.json",
  "title": "Cascade QA artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "selected_skill", "artifact_kind", "status", "subject", "sources", "coverage", "tests", "evidence", "defects", "quality_gate", "execution_requests", "handoffs", "boundaries"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_id": {"type": "string", "pattern": "^QA-[A-Z0-9][A-Z0-9._-]*$"},
    "selected_skill": {"enum": ["plan-quality", "design-tests", "assess-quality", "triage-defects"]},
    "artifact_kind": {"enum": ["QUALITY_PLAN", "TEST_DESIGN", "QUALITY_ASSESSMENT", "DEFECT_TRIAGE"]},
    "status": {"enum": ["READY", "GAP", "BLOCKED", "PASS", "FAIL", "AMBIGUOUS"]},
    "subject": {"$ref": "#/$defs/subject"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "coverage": {"type": "array", "items": {"$ref": "#/$defs/coverage"}},
    "tests": {"type": "array", "items": {"$ref": "#/$defs/test"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "defects": {"type": "array", "items": {"$ref": "#/$defs/defect"}},
    "quality_gate": {"$ref": "#/$defs/gate"},
    "execution_requests": {"type": "array", "items": {"$ref": "#/$defs/executionRequest"}},
    "handoffs": {"type": "array", "items": {"$ref": "#/$defs/handoff"}},
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_story_authored", "runtime_code_changed", "tests_executed", "test_files_changed", "release_approved"],
      "properties": {
        "product_story_authored": {"const": false},
        "runtime_code_changed": {"const": false},
        "tests_executed": {"const": false},
        "test_files_changed": {"const": false},
        "release_approved": {"const": false}
      }
    }
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "evidenceStatus": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "GAP", "STALE"]},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "behavior_ref", "decision_owner"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "behavior_ref": {"$ref": "#/$defs/nullableString"},
        "decision_owner": {"$ref": "#/$defs/nullableString"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "identity", "digest", "status"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9._-]*$"},
        "kind": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/nullableString"},
        "status": {"enum": ["CURRENT", "STALE", "MISSING", "CONFLICTING"]}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "risk_ref", "requirement_ref", "contour", "required", "status", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^COV-[A-Z0-9][A-Z0-9._-]*$"},
        "risk_ref": {"$ref": "#/$defs/nullableString"},
        "requirement_ref": {"type": "string", "minLength": 1},
        "contour": {"enum": ["SOURCE", "UNIT", "CONTRACT", "INTEGRATION", "FUNCTIONAL", "BROWSER", "API", "CLI", "ACCESSIBILITY", "SECURITY", "PERFORMANCE", "VISUAL", "SEMANTIC_EVAL", "SIMULATION", "PROVIDER", "DEPLOYMENT", "RELEASE"]},
        "required": {"type": "boolean"},
        "status": {"$ref": "#/$defs/evidenceStatus"},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "behavior_ref", "risk_ref", "contour", "preconditions", "data_class", "actions", "expected_observations", "evidence_requirements", "cleanup"],
      "properties": {
        "id": {"type": "string", "pattern": "^TC-[A-Z0-9][A-Z0-9._-]*$"},
        "behavior_ref": {"type": "string", "minLength": 1},
        "risk_ref": {"type": "string", "minLength": 1},
        "contour": {"type": "string", "minLength": 1},
        "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "data_class": {"enum": ["synthetic", "fixture", "masked", "production", "prohibited"]},
        "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "expected_observations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "cleanup": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "producer", "subject_ref", "case_ref", "environment", "observed_at", "status", "claim_scope"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^EV-[A-Z0-9][A-Z0-9._-]*$"},
        "producer": {"type": "string", "minLength": 1},
        "subject_ref": {"type": "string", "minLength": 1},
        "case_ref": {"$ref": "#/$defs/nullableString"},
        "environment": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/evidenceStatus"},
        "claim_scope": {"type": "string", "minLength": 1}
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "test_ref", "behavior_ref", "observation_ref", "classification", "confidence", "evidence_refs", "repair_owner", "prohibited_shortcuts", "rerun_contract"],
      "properties": {
        "id": {"type": "string", "pattern": "^DEFECT-[A-Z0-9][A-Z0-9._-]*$"},
        "test_ref": {"type": "string", "minLength": 1},
        "behavior_ref": {"type": "string", "minLength": 1},
        "observation_ref": {"type": "string", "minLength": 1},
        "classification": {"enum": ["PRODUCT_DEFECT", "TEST_DRIFT", "ENVIRONMENT_OR_TOOLING", "FLAKY", "AMBIGUOUS"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "repair_owner": {"$ref": "#/$defs/nullableString"},
        "prohibited_shortcuts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "rerun_contract": {"type": "string", "minLength": 1},
        "public_boundary_status": {"$ref": "#/$defs/evidenceStatus"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation", "acceptance_owner", "required_evidence_refs", "blockers"],
      "properties": {
        "recommendation": {"enum": ["PASS", "FAIL", "BLOCKED", "AMBIGUOUS"]},
        "acceptance_owner": {"$ref": "#/$defs/nullableString"},
        "required_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "executionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter_id", "input_refs", "expected_receipt", "authority_status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "adapter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
        "input_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "expected_receipt": {"type": "string", "minLength": 1},
        "authority_status": {"enum": ["PROPOSED", "AUTHORIZED", "BLOCKED"]}
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "status", "reason", "input_refs", "expected_output"],
      "properties": {
        "route": {"type": "string", "minLength": 1},
        "status": {"enum": ["OPTIONAL", "REQUIRED", "BLOCKED", "COMPLETE"]},
        "reason": {"type": "string", "minLength": 1},
        "input_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "expected_output": {"type": "string", "minLength": 1}
      }
    }
  }
}
