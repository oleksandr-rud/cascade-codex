{
  "schema_version": 1,
  "template_id": "cascade-simulation-starter-v1",
  "files": [
    {
      "path": "evals/simulations/{{SIMULATION_ID}}/manifest.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}",
        "title": "{{TITLE}}",
        "purpose": "Bootstrap a deterministic, stateful simulation contract before target-specific calibration.",
        "population_files": [
          "evals/simulations/{{SIMULATION_ID}}/populations/default.json"
        ],
        "scenario_files": [
          "evals/simulations/{{SIMULATION_ID}}/scenarios/happy-path.json"
        ],
        "world_file": "evals/simulations/{{SIMULATION_ID}}/worlds/default.json",
        "dataset_file": "evals/simulations/{{SIMULATION_ID}}/datasets/cases.json",
        "metric_files": [
          "evals/metrics/{{SIMULATION_ID}}-task-success-v1.json"
        ],
        "treatment_files": [
          "evals/treatments/{{SIMULATION_ID}}-baseline-v1.json",
          "evals/treatments/{{SIMULATION_ID}}-candidate-v1.json"
        ],
        "calibration_file": "evals/calibrations/{{SIMULATION_ID}}-framework-v1.json"
      }
    },
    {
      "path": "evals/simulations/{{SIMULATION_ID}}/populations/default.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-actors-v1",
        "source": {
          "kind": "synthetic",
          "description": "Starter actors generated by Cascade; replace or calibrate before target-project claims.",
          "minimized": true
        },
        "actors": [
          {
            "id": "{{SIMULATION_ID}}-standard-actor",
            "weight": 0.8,
            "behavior": {
              "risk_profile": "standard"
            },
            "slices": [
              "standard"
            ]
          },
          {
            "id": "{{SIMULATION_ID}}-risk-actor",
            "weight": 0.2,
            "behavior": {
              "risk_profile": "risk"
            },
            "slices": [
              "risk"
            ]
          }
        ]
      }
    },
    {
      "path": "evals/simulations/{{SIMULATION_ID}}/scenarios/happy-path.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-happy-path-v1",
        "goal": "Move the starter world from pending to completed.",
        "actor_ids": [
          "{{SIMULATION_ID}}-standard-actor",
          "{{SIMULATION_ID}}-risk-actor"
        ],
        "initial_state": {
          "workflow.status": "pending"
        },
        "stop_conditions": [
          "workflow.status equals completed"
        ],
        "claim_ids": [
          "{{SIMULATION_ID}}-state-transition",
          "{{SIMULATION_ID}}-release-eligibility"
        ]
      }
    },
    {
      "path": "evals/simulations/{{SIMULATION_ID}}/worlds/default.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-world-v1",
        "fixture_file": "evals/simulations/{{SIMULATION_ID}}/worlds/default.fixture.json",
        "allowed_actions": [
          "assert",
          "set",
          "increment",
          "deny",
          "fail"
        ],
        "negative_behaviors": [
          "unknown actions are denied by default",
          "state assertions fail on mismatched values",
          "cleanup resets the world to its frozen fixture"
        ],
        "cleanup": {
          "reset_to_fixture": true
        }
      }
    },
    {
      "path": "evals/simulations/{{SIMULATION_ID}}/worlds/default.fixture.json",
      "content": {
        "workflow": {
          "status": "pending"
        }
      }
    },
    {
      "path": "evals/simulations/{{SIMULATION_ID}}/datasets/cases.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-cases-v1",
        "leakage_policy": "exclusive-case-identity",
        "cases": [
          {
            "id": "{{SIMULATION_ID}}-development-standard",
            "scenario_id": "{{SIMULATION_ID}}-happy-path-v1",
            "actor_id": "{{SIMULATION_ID}}-standard-actor",
            "partition": "development",
            "slices": [
              "standard"
            ]
          },
          {
            "id": "{{SIMULATION_ID}}-regression-risk",
            "scenario_id": "{{SIMULATION_ID}}-happy-path-v1",
            "actor_id": "{{SIMULATION_ID}}-risk-actor",
            "partition": "regression",
            "slices": [
              "risk"
            ]
          },
          {
            "id": "{{SIMULATION_ID}}-holdout-standard",
            "scenario_id": "{{SIMULATION_ID}}-happy-path-v1",
            "actor_id": "{{SIMULATION_ID}}-standard-actor",
            "partition": "holdout",
            "slices": [
              "standard"
            ]
          },
          {
            "id": "{{SIMULATION_ID}}-calibration-standard-a",
            "scenario_id": "{{SIMULATION_ID}}-happy-path-v1",
            "actor_id": "{{SIMULATION_ID}}-standard-actor",
            "partition": "calibration-reference",
            "slices": [
              "standard"
            ]
          },
          {
            "id": "{{SIMULATION_ID}}-calibration-risk-a",
            "scenario_id": "{{SIMULATION_ID}}-happy-path-v1",
            "actor_id": "{{SIMULATION_ID}}-risk-actor",
            "partition": "calibration-reference",
            "slices": [
              "risk"
            ]
          },
          {
            "id": "{{SIMULATION_ID}}-calibration-standard-b",
            "scenario_id": "{{SIMULATION_ID}}-happy-path-v1",
            "actor_id": "{{SIMULATION_ID}}-standard-actor",
            "partition": "calibration-reference",
            "slices": [
              "standard"
            ]
          }
        ]
      }
    },
    {
      "path": "evals/metrics/{{SIMULATION_ID}}-task-success-v1.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-task-success-v1",
        "kind": "deterministic",
        "direction": "higher-is-better",
        "unit": "ratio",
        "aggregation": "mean",
        "hard_gate": true,
        "required_slices": [
          "standard",
          "risk"
        ],
        "uncertainty": "none",
        "source": {
          "oracle_id": "{{SIMULATION_ID}}-completed-v1"
        }
      }
    },
    {
      "path": "evals/treatments/{{SIMULATION_ID}}-baseline-v1.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-baseline-v1",
        "baseline": true,
        "target": {
          "source_revision": "replace-with-baseline-revision",
          "model": "deterministic-starter",
          "prompt_digest": "{{BASELINE_PROMPT_DIGEST}}",
          "tool_digest": "{{BASELINE_TOOL_DIGEST}}",
          "harness_digest": "{{HARNESS_DIGEST}}"
        }
      }
    },
    {
      "path": "evals/treatments/{{SIMULATION_ID}}-candidate-v1.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-candidate-v1",
        "baseline": false,
        "target": {
          "source_revision": "replace-with-candidate-revision",
          "model": "deterministic-starter",
          "prompt_digest": "{{CANDIDATE_PROMPT_DIGEST}}",
          "tool_digest": "{{CANDIDATE_TOOL_DIGEST}}",
          "harness_digest": "{{HARNESS_DIGEST}}"
        }
      }
    },
    {
      "path": "evals/calibrations/{{SIMULATION_ID}}-framework-v1.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-framework-calibration-v1",
        "simulation_id": "{{SIMULATION_ID}}",
        "dataset_id": "{{SIMULATION_ID}}-cases-v1",
        "treatment_ids": [
          "{{SIMULATION_ID}}-baseline-v1",
          "{{SIMULATION_ID}}-candidate-v1"
        ],
        "metric_ids": [
          "{{SIMULATION_ID}}-task-success-v1"
        ],
        "simulated_scores_file": "evals/calibrations/fixtures/{{SIMULATION_ID}}-framework.simulated.json",
        "reference_scores_file": "evals/calibrations/fixtures/{{SIMULATION_ID}}-framework.reference.json",
        "reference": {
          "kind": "framework-fixture",
          "label_digest": "{{REFERENCE_LABEL_DIGEST}}",
          "reference_window_end": "{{REFERENCE_WINDOW_END}}",
          "reviewer_identity": "replace-with-independent-reviewer"
        },
        "thresholds": {
          "minimum_samples": 3,
          "minimum_rank_correlation": 0.9,
          "minimum_linear_correlation": 0.9,
          "minimum_human_agreement": 0.8
        },
        "required_slices": [
          "standard",
          "risk"
        ],
        "staleness_days": 365,
        "framework_fixture": true
      }
    },
    {
      "path": "evals/calibrations/fixtures/{{SIMULATION_ID}}-framework.simulated.json",
      "content": [
        {
          "case_id": "{{SIMULATION_ID}}-calibration-standard-a",
          "treatment_id": "{{SIMULATION_ID}}-baseline-v1",
          "metric_id": "{{SIMULATION_ID}}-task-success-v1",
          "slice": "standard",
          "value": 0.4
        },
        {
          "case_id": "{{SIMULATION_ID}}-calibration-risk-a",
          "treatment_id": "{{SIMULATION_ID}}-baseline-v1",
          "metric_id": "{{SIMULATION_ID}}-task-success-v1",
          "slice": "risk",
          "value": 0.3
        },
        {
          "case_id": "{{SIMULATION_ID}}-calibration-standard-b",
          "treatment_id": "{{SIMULATION_ID}}-baseline-v1",
          "metric_id": "{{SIMULATION_ID}}-task-success-v1",
          "slice": "standard",
          "value": 0.5
        },
        {
          "case_id": "{{SIMULATION_ID}}-calibration-standard-a",
          "treatment_id": "{{SIMULATION_ID}}-candidate-v1",
          "metric_id": "{{SIMULATION_ID}}-task-success-v1",
          "slice": "standard",
          "value": 0.8
        },
        {
          "case_id": "{{SIMULATION_ID}}-calibration-risk-a",
          "treatment_id": "{{SIMULATION_ID}}-candidate-v1",
          "metric_id": "{{SIMULATION_ID}}-task-success-v1",
          "slice": "risk",
          "value": 0.7
        },
        {
          "case_id": "{{SIMULATION_ID}}-calibration-standard-b",
          "treatment_id": "{{SIMULATION_ID}}-candidate-v1",
          "metric_id": "{{SIMULATION_ID}}-task-success-v1",
          "slice": "standard",
          "value": 0.9
        }
      ]
    },
    {
      "path": "evals/calibrations/fixtures/{{SIMULATION_ID}}-framework.reference.json",
      "content": [
        {
          "case_id": "{{SIMULATION_ID}}-calibration-standard-a",
          "treatment_id": "{{SIMULATION_ID}}-baseline-v1",
          "metric_id": "{{SIMULATION_ID}}-task-success-v1",
          "slice": "standard",
          "value": 0.35,
          "human_label": 0,
          "judge_label": 0
        },
        {
          "case_id": "{{SIMULATION_ID}}-calibration-risk-a",
          "treatment_id": "{{SIMULATION_ID}}-baseline-v1",
          "metric_id": "{{SIMULATION_ID}}-task-success-v1",
          "slice": "risk",
          "value": 0.3,
          "human_label": 0,
          "judge_label": 0
        },
        {
          "case_id": "{{SIMULATION_ID}}-calibration-standard-b",
          "treatment_id": "{{SIMULATION_ID}}-baseline-v1",
          "metric_id": "{{SIMULATION_ID}}-task-success-v1",
          "slice": "standard",
          "value": 0.4,
          "human_label": 0,
          "judge_label": 0
        },
        {
          "case_id": "{{SIMULATION_ID}}-calibration-standard-a",
          "treatment_id": "{{SIMULATION_ID}}-candidate-v1",
          "metric_id": "{{SIMULATION_ID}}-task-success-v1",
          "slice": "standard",
          "value": 0.78,
          "human_label": 1,
          "judge_label": 1
        },
        {
          "case_id": "{{SIMULATION_ID}}-calibration-risk-a",
          "treatment_id": "{{SIMULATION_ID}}-candidate-v1",
          "metric_id": "{{SIMULATION_ID}}-task-success-v1",
          "slice": "risk",
          "value": 0.68,
          "human_label": 1,
          "judge_label": 1
        },
        {
          "case_id": "{{SIMULATION_ID}}-calibration-standard-b",
          "treatment_id": "{{SIMULATION_ID}}-candidate-v1",
          "metric_id": "{{SIMULATION_ID}}-task-success-v1",
          "slice": "standard",
          "value": 0.88,
          "human_label": 1,
          "judge_label": 1
        }
      ]
    },
    {
      "path": "evals/policies/{{SIMULATION_ID}}-allow-state-actions-v1.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-allow-state-actions-v1",
        "effect": "ALLOW",
        "action_types": [
          "assert",
          "set"
        ],
        "reason": "The generated deterministic starter permits declared in-memory state transitions only."
      }
    },
    {
      "path": "evals/oracles/{{SIMULATION_ID}}-completed-v1.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-completed-v1",
        "type": "state-equals",
        "path": "workflow.status",
        "expected": "completed"
      }
    },
    {
      "path": "evals/tasks/{{TASK_ID}}-STATE-SMOKE.json",
      "content": {
        "schema_version": 1,
        "id": "{{TASK_ID}}-STATE-SMOKE",
        "kind": "agent-response",
        "driver": {
          "type": "fake",
          "adapter": "generated-stateful-fixture-v1"
        },
        "required": true,
        "timeout_ms": 1000,
        "actions": [
          {
            "type": "assert",
            "path": "workflow.status",
            "value": "pending"
          },
          {
            "type": "set",
            "path": "workflow.status",
            "value": "completed"
          }
        ],
        "oracle_ids": [
          "{{SIMULATION_ID}}-completed-v1"
        ],
        "policy_ids": [
          "{{SIMULATION_ID}}-allow-state-actions-v1"
        ]
      }
    },
    {
      "path": "evals/claims/{{SIMULATION_ID}}-state-transition.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-state-transition",
        "class": "mechanical-behavior",
        "assertion": "The generated deterministic world applies its declared state transition and exposes the final state to its oracle.",
        "scope": {
          "simulation_id": "{{SIMULATION_ID}}",
          "world_id": "{{SIMULATION_ID}}-world-v1"
        },
        "required_policy_ids": [
          "{{SIMULATION_ID}}-allow-state-actions-v1"
        ],
        "required_oracle_ids": [
          "{{SIMULATION_ID}}-completed-v1"
        ],
        "required_metric_ids": [],
        "requires_calibration": false,
        "evidence_requirements": [
          "source-manifest",
          "execution-receipt",
          "task-result",
          "trajectory",
          "policy-decisions",
          "oracle",
          "cleanup"
        ]
      }
    },
    {
      "path": "evals/claims/{{SIMULATION_ID}}-release-eligibility.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-release-eligibility",
        "class": "release-eligibility",
        "assertion": "A current non-fixture calibration supports release eligibility for the exact target treatment and source identity.",
        "scope": {
          "simulation_id": "{{SIMULATION_ID}}",
          "target_project": "required"
        },
        "required_policy_ids": [
          "{{SIMULATION_ID}}-allow-state-actions-v1"
        ],
        "required_oracle_ids": [
          "{{SIMULATION_ID}}-completed-v1"
        ],
        "required_metric_ids": [
          "{{SIMULATION_ID}}-task-success-v1"
        ],
        "requires_calibration": true,
        "evidence_requirements": [
          "source-manifest",
          "execution-receipt",
          "policy-decisions",
          "oracle",
          "cleanup",
          "calibration-receipt"
        ]
      }
    },
    {
      "path": "evals/campaigns/{{SIMULATION_ID}}-smoke.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-smoke",
        "title": "{{TITLE}} smoke",
        "purpose": "Validate the generated deterministic simulation package without external services.",
        "owner_lane": "{{OWNER_LANE}}",
        "tier": "deterministic-fixture",
        "evaluation_profile_file": "evals/rubrics/deterministic-fixture-v1.json",
        "simulation_file": "evals/simulations/{{SIMULATION_ID}}/manifest.json",
        "task_files": [
          "evals/tasks/{{TASK_ID}}-STATE-SMOKE.json"
        ],
        "claim_files": [
          "evals/claims/{{SIMULATION_ID}}-state-transition.json",
          "evals/claims/{{SIMULATION_ID}}-release-eligibility.json"
        ],
        "policy_files": [
          "evals/policies/{{SIMULATION_ID}}-allow-state-actions-v1.json"
        ],
        "oracle_files": [
          "evals/oracles/{{SIMULATION_ID}}-completed-v1.json"
        ]
      }
    }
  ]
}
