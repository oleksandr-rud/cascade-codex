          "judge_label": 1
        }
      ]
    },
    {
      "path": "product-evals/policies/{{SIMULATION_ID}}-allow-state-actions-v1.json",
      "content": {
        "schema_version": 2,
        "id": "{{SIMULATION_ID}}-allow-state-actions-v1",
        "version": "2.0.0",
        "effect": "ALLOW",
        "scope": {
          "campaign_ids": [
            "{{SIMULATION_ID}}-smoke"
          ],
          "task_ids": [
            "{{TASK_ID}}-STATE-SMOKE"
          ],
          "task_kinds": [
            "agent-response"
          ],
          "driver_types": [
            "fake"
          ],
          "action_types": [
            "assert",
            "set"
          ],
          "action_paths": [
            "workflow.status"
          ]
        },
        "budgets": {
          "required_dimensions": [
            "action_count",
            "output_bytes"
          ],
          "max_actions": 4,
          "max_output_bytes": 65536
        },
        "redaction_profile": "no-secrets-v1",
        "reason": "The generated deterministic starter permits declared in-memory state transitions only."
      }
    },
    {
      "path": "product-evals/oracles/{{SIMULATION_ID}}-completed-v1.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-completed-v1",
        "type": "state-equals",
        "path": "workflow.status",
        "expected": "completed"
      }
    },
    {
      "path": "product-evals/tasks/{{TASK_ID}}-STATE-SMOKE.json",
      "content": {
        "schema_version": 1,
        "id": "{{TASK_ID}}-STATE-SMOKE",
        "kind": "agent-response",
        "driver": {
          "type": "fake",
          "adapter": "builtin-fake"
        },
        "required": true,
        "timeout_ms": 1000,
        "actions": [
          {
            "type": "assert",
            "path": "workflow.status",
            "value": "pending"
          },
          {
            "type": "set",
            "path": "workflow.status",
            "value": "completed"
          }
        ],
        "oracle_ids": [
          "{{SIMULATION_ID}}-completed-v1"
        ],
        "policy_ids": [
          "{{SIMULATION_ID}}-allow-state-actions-v1"
        ]
      }
    },
    {
      "path": "product-evals/claims/{{SIMULATION_ID}}-state-transition.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-state-transition",
        "class": "mechanical-behavior",
        "assertion": "The generated deterministic world applies its declared state transition and exposes the final state to its oracle.",
        "scope": {
          "simulation_id": "{{SIMULATION_ID}}",
          "world_id": "{{SIMULATION_ID}}-world-v1"
        },
        "population_authority": "none",
        "required_policy_ids": [
          "{{SIMULATION_ID}}-allow-state-actions-v1"
        ],
        "required_oracle_ids": [
          "{{SIMULATION_ID}}-completed-v1"
        ],
        "required_metric_ids": [],
        "requires_calibration": false,
        "evidence_requirements": [
          "source-manifest",
          "execution-receipt",
          "task-result",
          "trajectory",
          "policy-decisions",
          "oracle",
          "cleanup"
        ]
      }
    },
    {
      "path": "product-evals/claims/{{SIMULATION_ID}}-release-eligibility.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-release-eligibility",
        "class": "release-eligibility",
        "assertion": "A current non-fixture calibration supports release eligibility for the exact target treatment and source identity.",
        "scope": {
          "simulation_id": "{{SIMULATION_ID}}",
          "population_id": "{{SIMULATION_ID}}-actors-v1",
          "target_project": "required"
        },
        "population_authority": "estimated-prevalence",
        "required_policy_ids": [
          "{{SIMULATION_ID}}-allow-state-actions-v1"
        ],
        "required_oracle_ids": [
          "{{SIMULATION_ID}}-completed-v1"
        ],
        "required_metric_ids": [
          "{{SIMULATION_ID}}-task-success-v1"
        ],
        "requires_calibration": true,
        "evidence_requirements": [
          "source-manifest",
          "execution-receipt",
          "policy-decisions",
          "oracle",
          "cleanup",
          "calibration-receipt"
        ]
      }
    },
    {
      "path": "product-evals/intakes/product/seed-bindings/{{SIMULATION_ID}}-smoke.json",
      "content": {
        "schema_version": 1,
        "artifact_type": "cascade-simulation-seed-binding",
        "id": "{{SIMULATION_ID}}-seed-binding-v1",
        "status": "DRAFT",
        "campaign_id": "{{SIMULATION_ID}}-smoke",
        "campaign_sha256": "{{CAMPAIGN_SHA256}}",
        "source": {
          "task_envelope_id": null,
          "task_envelope_revision": null,
          "request_digest": null,
          "source_digest": null
        },
        "mappings": []
      }
    },
    {
      "path": "product-evals/intakes/product/{{SIMULATION_ID}}-smoke.json",
      "content": {
        "schema_version": 6,
        "artifact_type": "cascade-simulation-intake",
        "id": "SI-{{INTAKE_ID}}",
        "status": "DRAFT",
        "scope": "product",
        "campaign_id": "{{SIMULATION_ID}}-smoke",
        "produced_at": "{{REFERENCE_WINDOW_END}}",
        "task_envelope": null,
        "product_context": null,
        "seed_binding": null,
        "claims": [],
        "tasks": [],
        "blockers": [
          "compile a current Task Envelope and product brief into this intake before execution"
        ],
        "gaps": [
          "product context and exact action-policy equality have not been compiled"
        ],
        "invalidation": [
          "task envelope revision",
          "product brief or generated output digest",
          "campaign task or policy digest"
        ]
      }
    },
    {
      "path": "product-evals/campaigns/{{SIMULATION_ID}}-smoke.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-smoke",
        "title": "{{TITLE}} smoke",
        "purpose": "Validate the generated deterministic simulation package without external services.",
        "owner_lane": "{{OWNER_LANE}}",
        "tier": "deterministic-fixture",
        "session": {
          "max_duration_ms": 300000,
          "max_step_duration_ms": 15000,
          "max_steps": 100,
          "max_parallel_steps": 1,
          "max_steps_per_episode": 25,
          "max_surfaces": 4,
          "max_checkpoint_bytes": 1048576,
          "lease_ttl_ms": 60000
        },
        "evaluation_profile_file": "product-evals/rubrics/deterministic-fixture-v1.json",
      "simulation_file": "product-evals/simulations/product/{{SIMULATION_ID}}/manifest.json",
      "intake_file": "product-evals/intakes/product/{{SIMULATION_ID}}-smoke.json",
      "seed_binding_file": "product-evals/intakes/product/seed-bindings/{{SIMULATION_ID}}-smoke.json",
      "specialized_evaluation": null,
      "task_files": [
          "product-evals/tasks/{{TASK_ID}}-STATE-SMOKE.json"
        ],
        "claim_files": [
          "product-evals/claims/{{SIMULATION_ID}}-state-transition.json",
          "product-evals/claims/{{SIMULATION_ID}}-release-eligibility.json"
        ],
        "policy_files": [
          "product-evals/policies/{{SIMULATION_ID}}-allow-state-actions-v1.json"
        ],
        "oracle_files": [
          "product-evals/oracles/{{SIMULATION_ID}}-completed-v1.json"
        ]
      }
    }
  ]
