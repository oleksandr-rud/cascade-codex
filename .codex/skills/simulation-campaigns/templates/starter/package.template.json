{
  "schema_version": 1,
  "template_id": "cascade-simulation-starter-v1",
  "files": [
    {
      "path": "product-evals/simulations/product/{{SIMULATION_ID}}/manifest.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}",
        "simulation_scope": "product",
        "title": "{{TITLE}}",
        "purpose": "Bootstrap a deterministic, stateful simulation contract before target-specific calibration.",
        "population_files": [
          "product-evals/simulations/product/{{SIMULATION_ID}}/populations/default.json"
        ],
        "scenario_files": [
          "product-evals/simulations/product/{{SIMULATION_ID}}/scenarios/happy-path.json"
        ],
        "world_file": "product-evals/simulations/product/{{SIMULATION_ID}}/worlds/default.json",
        "dataset_file": "product-evals/simulations/product/{{SIMULATION_ID}}/datasets/cases.json",
        "metric_files": [
          "product-evals/metrics/{{SIMULATION_ID}}-task-success-v1.json"
        ],
        "treatment_files": [
          "product-evals/treatments/{{SIMULATION_ID}}-baseline-v1.json",
          "product-evals/treatments/{{SIMULATION_ID}}-candidate-v1.json"
        ],
        "calibration_file": "product-evals/calibrations/{{SIMULATION_ID}}-framework-v1.json"
      }
    },
    {
      "path": "product-evals/simulations/product/{{SIMULATION_ID}}/populations/default.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-actors-v1",
        "source": {
          "kind": "synthetic",
          "description": "Starter actors generated by Cascade with test-allocation weights only; replace or calibrate before target-project claims and never interpret these weights as prevalence.",
          "minimized": true
        },
        "actors": [
          {
            "id": "{{SIMULATION_ID}}-standard-actor",
            "weight": 0.8,
            "behavior": {
              "risk_profile": "standard"
            },
            "slices": [
              "standard"
            ]
          },
          {
            "id": "{{SIMULATION_ID}}-risk-actor",
            "weight": 0.2,
            "behavior": {
              "risk_profile": "risk"
            },
            "slices": [
              "risk"
            ]
          }
        ]
      }
    },
    {
      "path": "product-evals/simulations/product/{{SIMULATION_ID}}/scenarios/happy-path.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-happy-path-v1",
        "goal": "Move the starter world from pending to completed.",
        "actor_ids": [
          "{{SIMULATION_ID}}-standard-actor",
          "{{SIMULATION_ID}}-risk-actor"
        ],
        "initial_state": {
          "workflow.status": "pending"
        },
        "stop_conditions": [
          "workflow.status equals completed"
        ],
        "claim_ids": [
          "{{SIMULATION_ID}}-state-transition",
          "{{SIMULATION_ID}}-release-eligibility"
        ]
      }
    },
    {
      "path": "product-evals/simulations/product/{{SIMULATION_ID}}/worlds/default.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-world-v1",
        "fixture_file": "product-evals/simulations/product/{{SIMULATION_ID}}/worlds/default.fixture.json",
        "allowed_actions": [
          "assert",
          "set",
          "increment",
          "deny",
          "fail"
        ],
        "negative_behaviors": [
          "unknown actions are denied by default",
          "state assertions fail on mismatched values",
          "cleanup resets the world to its frozen fixture"
        ],
        "cleanup": {
          "reset_to_fixture": true
        }
      }
    },
    {
      "path": "product-evals/simulations/product/{{SIMULATION_ID}}/worlds/default.fixture.json",
      "content": {
        "workflow": {
          "status": "pending"
        }
      }
    },
    {
      "path": "product-evals/simulations/product/{{SIMULATION_ID}}/datasets/cases.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-cases-v1",
        "leakage_policy": "exclusive-case-identity",
        "cases": [
          {
            "id": "{{SIMULATION_ID}}-development-standard",
            "scenario_id": "{{SIMULATION_ID}}-happy-path-v1",
            "actor_id": "{{SIMULATION_ID}}-standard-actor",
            "partition": "development",
            "slices": [
              "standard"
            ]
          },
          {
            "id": "{{SIMULATION_ID}}-regression-risk",
            "scenario_id": "{{SIMULATION_ID}}-happy-path-v1",
            "actor_id": "{{SIMULATION_ID}}-risk-actor",
            "partition": "regression",
            "slices": [
              "risk"
            ]
          },
          {
            "id": "{{SIMULATION_ID}}-holdout-standard",
            "scenario_id": "{{SIMULATION_ID}}-happy-path-v1",
            "actor_id": "{{SIMULATION_ID}}-standard-actor",
            "partition": "holdout",
            "slices": [
              "standard"
            ]
          },
          {
            "id": "{{SIMULATION_ID}}-calibration-standard-a",
            "scenario_id": "{{SIMULATION_ID}}-happy-path-v1",
            "actor_id": "{{SIMULATION_ID}}-standard-actor",
            "partition": "calibration-reference",
            "slices": [
              "standard"
            ]
          },
          {
            "id": "{{SIMULATION_ID}}-calibration-risk-a",
            "scenario_id": "{{SIMULATION_ID}}-happy-path-v1",
            "actor_id": "{{SIMULATION_ID}}-risk-actor",
            "partition": "calibration-reference",
            "slices": [
              "risk"
            ]
          },
          {
            "id": "{{SIMULATION_ID}}-calibration-standard-b",
            "scenario_id": "{{SIMULATION_ID}}-happy-path-v1",
            "actor_id": "{{SIMULATION_ID}}-standard-actor",
            "partition": "calibration-reference",
            "slices": [
              "standard"
            ]
          }
        ]
      }
    },
    {
      "path": "product-evals/metrics/{{SIMULATION_ID}}-task-success-v1.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-task-success-v1",
        "kind": "deterministic",
        "direction": "higher-is-better",
        "unit": "ratio",
        "aggregation": "mean",
        "hard_gate": true,
        "required_slices": [
          "standard",
          "risk"
        ],
        "uncertainty": "none",
        "source": {
          "oracle_id": "{{SIMULATION_ID}}-completed-v1"
        }
      }
    },
    {
      "path": "product-evals/treatments/{{SIMULATION_ID}}-baseline-v1.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-baseline-v1",
        "baseline": true,
        "target": {
          "source_revision": "replace-with-baseline-revision",
          "model": "deterministic-starter",
          "prompt_digest": "{{BASELINE_PROMPT_DIGEST}}",
          "tool_digest": "{{BASELINE_TOOL_DIGEST}}",
          "harness_digest": "{{HARNESS_DIGEST}}"
        }
      }
    },
    {
      "path": "product-evals/treatments/{{SIMULATION_ID}}-candidate-v1.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-candidate-v1",
        "baseline": false,
        "target": {
          "source_revision": "replace-with-candidate-revision",
          "model": "deterministic-starter",
          "prompt_digest": "{{CANDIDATE_PROMPT_DIGEST}}",
          "tool_digest": "{{CANDIDATE_TOOL_DIGEST}}",
          "harness_digest": "{{HARNESS_DIGEST}}"
        }
      }
    },
    {
      "path": "product-evals/calibrations/{{SIMULATION_ID}}-framework-v1.json",
      "content": {
        "schema_version": 1,
        "id": "{{SIMULATION_ID}}-framework-calibration-v1",
        "simulation_id": "{{SIMULATION_ID}}",
        "dataset_id": "{{SIMULATION_ID}}-cases-v1",
        "treatment_ids": [
          "{{SIMULATION_ID}}-baseline-v1",
          "{{SIMULATION_ID}}-candidate-v1"
        ],
        "metric_ids": [
          "{{SIMULATION_ID}}-task-success-v1"
        ],
        "simulated_scores_file": "product-evals/calibrations/fixtures/{{SIMULATION_ID}}-framework.simulated.json",
        "reference_scores_file": "product-evals/calibrations/fixtures/{{SIMULATION_ID}}-framework.reference.json",
        "reference": {
          "kind": "framework-fixture",
          "label_digest": "{{REFERENCE_LABEL_DIGEST}}",
          "reference_window_end": "{{REFERENCE_WINDOW_END}}",
          "reviewer_identity": "replace-with-independent-reviewer"
        },
        "thresholds": {
          "minimum_samples": 3,
          "minimum_rank_correlation": 0.9,
          "minimum_linear_correlation": 0.9,
          "minimum_human_agreement": 0.8
        },
        "required_slices": [
          "standard",
          "risk"
        ],
        "staleness_days": 365,
        "framework_fixture": true
      }
    },
    {
      "path": "product-evals/calibrations/fixtures/{{SIMULATION_ID}}-framework.simulated.json",
      "content": [
        {
          "case_id": "{{SIMULATION_ID}}-calibration-standard-a",
          "treatment_id": "{{SIMULATION_ID}}-baseline-v1",
          "metric_id": "{{SIMULATION_ID}}-task-success-v1",
          "slice": "standard",
          "value": 0.4
        },
        {
          "case_id": "{{SIMULATION_ID}}-calibration-risk-a",
