{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/harness-config.schema.json",
  "title": "Cascade target harness configuration",
  "type": "object",
  "required": [
    "project",
    "models",
    "paths",
    "validation_commands",
    "routing",
    "functional_acceptance",
    "memory",
    "patterns"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "primary_users",
        "stack"
      ]
    },
    "models": {
      "type": "object",
      "required": [
        "default",
        "planning",
        "judged_evaluation",
        "subagent_execution",
        "read_heavy"
      ],
      "properties": {
        "default": {
          "type": "string"
        },
        "planning": {
          "type": "string"
        },
        "judged_evaluation": {
          "type": "string"
        },
        "subagent_execution": {
          "type": "string"
        },
        "read_heavy": {
          "type": "string"
        }
      },
      "not": {
        "required": [
          "golden_evaluation"
        ]
      }
    },
    "paths": {
      "type": "object",
      "required": [
        "source_roots",
        "test_roots",
        "app_entrypoints",
        "public_contracts",
        "docs_root",
        "structure",
        "glossary",
        "active_work",
        "patterns",
        "pattern_context_builder",
        "task_admission_schema",
        "task_admission_policy",
        "task_admission_hook",
        "task_admission_runner",
        "task_admission_cases",
        "harness_evals",
        "harness_eval_runner",
        "harness_eval_artifacts",
        "simulation_campaigns",
        "simulation_artifacts",
        "simulation_artifact_policy",
        "harness_simulations",
        "product_simulations"
      ],
      "properties": {
        "product_catalog": {
          "const": "docs/product/catalog.yaml"
        },
        "product_catalog_schema": {
          "const": "docs/product/catalog.schema.json"
        },
        "product_brief_schema": {
          "const": "docs/specs/brief-manifest.schema.json"
        },
        "product_brief_runner": {
          "const": "scripts/cascade/briefs.ts"
        },
        "task_admission_schema": {
          "const": ".codex/task-admission/task-envelope.schema.json"
        },
        "task_admission_policy": {
          "const": ".codex/task-admission/policies/core.json"
        },
        "task_admission_hook": {
          "const": ".codex/hooks.json"
        },
        "task_admission_runner": {
          "const": "scripts/cascade/admission.ts"
        },
        "task_admission_cases": {
          "const": "harness-evals/task-admission/cases.json"
        },
        "harness_evals": {
          "const": "harness-evals"
        },
        "harness_eval_artifacts": {
          "const": ".artifacts/harness-evals"
        },
        "simulation_campaigns": {
          "const": "product-evals/campaigns"
        },
        "simulation_artifacts": {
          "const": ".artifacts/product-evals"
        },
        "simulation_artifact_policy": {
          "const": "product-evals/artifact-policy.json"
        },
        "harness_simulations": {
          "const": "product-evals/simulations/harness"
        },
        "product_simulations": {
          "const": "product-evals/simulations/product"
        }
      }
    },
    "validation_commands": {
      "type": "object",
      "required": [
        "install",
        "targeted",
        "unit",
        "lint",
        "typecheck",
        "build",
        "functional",
        "e2e"
      ]
    },
    "routing": {
      "type": "object",
      "required": ["admission", "non_atomic_fallback_path"],
      "not": { "required": ["new_task_path"] }
    },
    "functional_acceptance": {
      "type": "object"
    },
    "memory": {
      "type": "object"
    },
    "patterns": {
      "type": "object"
    }
  }
}
